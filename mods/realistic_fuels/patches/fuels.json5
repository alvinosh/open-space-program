// What the base game burns and holds, put back to the real thing. In the first pass, so a mod that
// copies a stock engine copies it with these. Each engine loses the liquid fuel and oxidiser it burns
// in the base game and the plume it names for them, since the real propellants pick their own.
[
  // What each engine burns.
  { op: "merge", collection: "engines", target: "K-1 Booster", pass: "first", value: {"propellants": {"Liquid Fuel": null, "Oxidiser": null, "Kerosene": 1.0, "LqdOxygen": 2.36}} },
  { op: "merge", collection: "engines", target: "K-1 Vacuum", pass: "first", value: {"propellants": {"Liquid Fuel": null, "Oxidiser": null, "Kerosene": 1.0, "LqdOxygen": 2.36}} },
