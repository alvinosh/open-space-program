    {
      id: "command_module_pod",
      on: "command_module.pod",
      template: "Apollo Command Module (CM)",
      components: [{ life_support: {} }],
      // Low and to one side of the pod's own frame, which starts 1.085 m up the capsule: its
      // centre of mass off the axis trims it at an angle, and that is its lift.
      mass_center: [0.2, 0, -0.1],
    },
    // What brings the capsule home: its own thrusters and what they burn, its supplies, and five
