      name: "Landing leg",
      on: "lm_descent_stage.leg_4",
      model: { path: "models/parts/lm_foot_pad.glb" },
      shape: {
        compound: [
          {
            shape: { beam: { length: 3.2, section: { circle: { diameter: 0.14 } } } },
            rotation: [180, 0, 0],
          },
        ],
      },
      components: [
        { gear: { stowed: [0, -0.12, 0.993], length: 3.2, wheel_radius: 0.4, stroke: 0.8, load: 800, mass: 65, foot: true } },
