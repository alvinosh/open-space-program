      paint: { color: [0.72, 0.6, 0.3], finish: "metal" },
    },
  ],
  // The instrument unit's own: the centre F-1 shuts down at 2 min 15 s, holding the stack to
  // 3.9 g, and the outboard ones when the oxygen runs low, with a little left in the tanks.
  triggers: [
    { time: 135, fire: ["cutoff:s_ic_engine_1"] },
    { propellant_below: 0.01, of: "s_ic", fire: ["cutoff:s_ic"] },
  ],
  // The S-IVB's APS flies the stack; the service module's thrusters wait until it has let go.
  rcs_shut: [
    "rcs_quad_1",
    "rcs_quad_2",
    "rcs_quad_3",
    "rcs_quad_4",
    "cm_rcs_1",
    "cm_rcs_2",
    "cm_rcs_3",
    "cm_rcs_4",
  ],
  // Let go of the service module and all below it and pull the capsule away, then throw the tower
  // off. Anything already gone by then is passed over.
  abort: [
    { fire: ["decoupler:service_module", "engines:les_escape_motor"] },
    {
      after: 14,
      fire: [
        "engines:les_jettison_motor",
        "decoupler:les_decoupler",
        "rcs:cm_rcs_1",
        "arm:drogue_1",
        "arm:drogue_2",
        "arm:main_1",
        "arm:main_2",
        "arm:main_3",
      ],
    },
  ],
  sequences: [
    ["engines:s_ic"],
    // The S-IC falls away and the ullage motors push the stack forward; a moment later,
    // while they still burn, the J-2s start. The spent interstage goes after.
    [
      "engines:s_ic_retro_1",
      "engines:s_ic_retro_2",
      "engines:s_ic_retro_3",
      "engines:s_ic_retro_4",
      "decoupler:s_ic",
      "engines:s_ii_ullage_1",
      "engines:s_ii_ullage_2",
      "engines:s_ii_ullage_3",
      "engines:s_ii_ullage_4",
    ],
    ["engines:s_ii"],
    // The spent interstage, and the tower 30 s after the S-II lights.
    ["decoupler:interstage", "engines:les_jettison_motor", "decoupler:les_decoupler"],
    // The same for the S-IVB's first start, from its two ullage motors.
    ["decoupler:s_ii", "engines:s_ivb_ullage_1", "engines:s_ivb_ullage_2"],
    ["engines:s_ivb"],
    // The panels open and the CSM leaves, with its engine armed. The S-IVB takes the lunar module
    // and what is left for it to do with it: being let go, then its own two stages.
    [
      "fairing:adapter_panel_1", "fairing:adapter_panel_2", "fairing:adapter_panel_3", "fairing:adapter_panel_4",
      "decoupler:adapter_decoupler",
      "engines:service_module",
      "unfold:high_gain_antenna",
      "rcs:rcs_quad_1",
    ],
    ["decoupler:lm_mount"],
    [
      "rcs:lm_ascent_stage",
      "engines:lm_descent_stage",
      "deploy_leg:lm_leg_1",
      "deploy_leg:lm_leg_2",
      "deploy_leg:lm_leg_3",
      "deploy_leg:lm_leg_4",
    ],
    ["decoupler:lm_descent_stage", "engines:lm_ascent_stage"],
    // The capsule alone: its own thrusters, and its parachutes armed for the way down.
    [
      "decoupler:service_module",
      "rcs:cm_rcs_1",
      "arm:drogue_1",
      "arm:drogue_2",
      "arm:main_1",
      "arm:main_2",
      "arm:main_3",
    ],
  ],
}
