                  },
                ],
              },
            },
          },
          {
            name: "equipment",
            shape: { ring: { diameter: 3.9, height: 3.2, thickness: 1.95 } },
            unseen: true,
          },
        ],
      },
      structure: { thickness: 0, mass: 1560 },
      mass_center: [0.2, 0, 0.6],
      components: [{ heat_shield: { ablator: 850 } }, { antenna: { power: 20, data_rate: 1600 } }, { avionics: { controlled_mass: 50000, interplanetary: true } }, { electric_load: { watts: 1200, priority: 9, essential: true } }, { container: {} }, { docking_port: { node: "dock", kind: "probe", impulse: 2000 } }],
      nodes: [
        { name: "bottom", position: [0, 0, 0], direction: [0, 0, -1], size: 3.9 },
        { name: "top", position: [0, 0, 3.2], direction: [0, 0, 1], size: 3.9 },
        { name: "pod", position: [0, 0, 1.085], direction: [0, 0, 1], size: 3.918 },
        { name: "dock", position: [0, 0, 3.177], direction: [0, 0, 1], size: 1.0 },
        { name: "rcs_1", position: [1.28, 0, 1.75], direction: [1, 0, 0], size: 0.3 },
        { name: "rcs_2", position: [0, 1.28, 1.75], direction: [0, 1, 0], size: 0.3 },
        { name: "rcs_3", position: [-1.28, 0, 1.75], direction: [-1, 0, 0], size: 0.3 },
        { name: "rcs_4", position: [0, -1.28, 1.75], direction: [0, -1, 0], size: 0.3 },
        { name: "rcs_tank", position: [0.6, 0.6, 0.5], direction: [0, 0, 1], size: 0.6 },
