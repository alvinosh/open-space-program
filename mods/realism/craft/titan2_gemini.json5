// Titan II GLV (1965).
// The Titan II ICBM man-rated for Gemini: storable Aerozine 50 and nitrogen tetroxide, in
// separate fuel and oxidizer tanks in each stage. Built by hand from plain parts: the
// gemini_spacecraft and titan2_glv assemblies (mods/realism/assemblies/gemini.json5)
// placed together. The spacecraft drops its equipment section before retrofire and its
// retrograde section after. Colours and proportions are approximate.
{
  id: "titan2_gemini",
  name: "Titan II GLV",
  parts: [
    {
      id: "reentry",
      name: "Heat shield",
      shape: {
        shell: { bottom_diameter: 2.286, sections: [{ length: 0.12 }], cap_bottom: true },
      },
      structure: { mass: 260 },
      components: [{ container: {} }],
      paint: { finish: "char" },
