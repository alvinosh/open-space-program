// The Realistic game's contracts (assets/core/contracts says how they are written): many sounding
// rockets and uncrewed probes before anyone flies. Higher and higher sounding flights, an instrument
// brought back from space, the first satellite, then probes to the Moon while the first crews fly
// up and down and then into orbit, and only then crews to the Moon. Not RP-1's own programs: a
// shorter list in their spirit. Rewards are guesses until a whole career is played (T301).
[
  { id: "rp_first", tree: "rp1", title: "First rocket", description: "Leave the pad and climb a kilometre.",
    when: { type: "Altitude", min: 1000 }, reward: 20000, days: 90 },
  { id: "rp_5km", tree: "rp1", title: "Sound the sky to 5 km", after: ["rp_first"],
    description: "Carry the first instruments 5 km up.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 5000 }] }, reward: 25000, days: 90 },
  { id: "rp_20km", tree: "rp1", title: "Sound the sky to 20 km", after: ["rp_5km"],
    description: "Into the stratosphere.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 20000 }] }, reward: 35000, days: 90 },
  { id: "rp_50km", tree: "rp1", title: "Sound the sky to 50 km", after: ["rp_20km"],
    description: "As high as the first V-2s from White Sands.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 50000 }] }, reward: 50000, days: 120 },
  { id: "rp_space", tree: "rp1", title: "Reach space", after: ["rp_50km"],
    description: "Pass the Kármán line, 100 km up.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 100000 }] }, reward: 80000, days: 180 },
  { id: "rp_return", tree: "rp1", title: "Back from space", after: ["rp_space"],
    description: "Bring something down whole from above 100 km, as the V-2s' film came back.",
    when: { type: "All", of: [{ type: "Reached", altitude: 100000 }, { type: "Recovered" }] }, reward: 100000, days: 180 },
  { id: "rp_200km", tree: "rp1", title: "Sound to 200 km", after: ["rp_space"],
    description: "A sounding rocket twice as high as space begins.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 200000 }] }, reward: 120000, days: 180 },
  { id: "rp_1000km", tree: "rp1", title: "Sound to 1,000 km", after: ["rp_200km"],
    description: "Up through the first radiation belt's edge and down again.",
    when: { type: "All", of: [{ type: "Visit", body: "Earth" }, { type: "Altitude", min: 1000000 }] }, reward: 200000, days: 365 },
  { id: "rp_satellite", tree: "rp1", title: "First satellite", after: ["rp_1000km"],
    description: "An uncrewed satellite in orbit of the Earth.",
    when: { type: "All", of: [{ type: "Orbit", body: "Earth", periapsis: { min: 150000 } }, { type: "Crew", max: 0 }] }, reward: 400000, days: 365 },
  { id: "rp_high_satellite", tree: "rp1", title: "A satellite in space high", after: ["rp_satellite"],
    description: "An uncrewed satellite orbiting above 2,000 km.",
    when: { type: "All", of: [{ type: "Orbit", body: "Earth", periapsis: { min: 2000000 } }, { type: "Crew", max: 0 }] }, reward: 450000, days: 365 },
  { id: "rp_moon_probe", tree: "rp1", title: "A probe to the Moon", after: ["rp_satellite"],
    description: "An uncrewed probe into the Moon's sphere of influence.",
    when: { type: "All", of: [{ type: "Visit", body: "Moon" }, { type: "Crew", max: 0 }] }, reward: 900000, days: 730 },
  { id: "rp_crew_space", tree: "rp1", title: "A person to space and back", after: ["rp_satellite", "rp_return"],
    description: "Someone above 100 km, and down again safely.",
    when: { type: "All", of: [{ type: "Reached", altitude: 100000 }, { type: "Recovered", max_g: 12 }, { type: "Crew", min: 1 }] }, reward: 600000, days: 365 },
  { id: "rp_crew_orbit", tree: "rp1", title: "A person in orbit", after: ["rp_crew_space"],
    description: "Someone in orbit of the Earth.",
    when: { type: "All", of: [{ type: "Orbit", body: "Earth", periapsis: { min: 150000 } }, { type: "Crew", min: 1 }] }, reward: 1200000, days: 730 },
  { id: "rp_moon_orbiter", tree: "rp1", title: "A probe in orbit of the Moon", after: ["rp_moon_probe"],
    description: "An uncrewed orbiter round the Moon.",
    when: { type: "All", of: [{ type: "Orbit", body: "Moon", periapsis: { min: 15000 } }, { type: "Crew", max: 0 }] }, reward: 1500000, days: 730 },
  { id: "rp_moon_lander", tree: "rp1", title: "A probe on the Moon", after: ["rp_moon_orbiter"],
    description: "An uncrewed lander set down on the Moon whole.",
    when: { type: "All", of: [{ type: "Landed", body: "Moon" }, { type: "Crew", max: 0 }] }, reward: 2500000, days: 730 },
  { id: "rp_crew_moon_orbit", tree: "rp1", title: "A crew round the Moon", after: ["rp_crew_orbit", "rp_moon_orbiter"],
    description: "People in orbit of the Moon.",
    when: { type: "All", of: [{ type: "Orbit", body: "Moon", periapsis: { min: 15000 } }, { type: "Crew", min: 1 }] }, reward: 4000000, days: 1095 },
  { id: "rp_crew_moon_landing", tree: "rp1", title: "A crew on the Moon", after: ["rp_crew_moon_orbit", "rp_moon_lander"],
    description: "People landed on the Moon.",
    when: { type: "All", of: [{ type: "Landed", body: "Moon" }, { type: "Crew", min: 1 }] }, reward: 8000000, days: 1095 },
]
