  },
  {
    "id": "FARAD",
    "title": "FARAD Pulsed Inductive Thruster",
    "manufacturer": "Marshall Space Flight Center",
    "description": "The pulsed inductive thruster uses a powerful magnetic pulse to ionize and accelerate gas. It can achieve impressive ISPs and be scaled up simply by increasing the pulse rate. However, it consumes a considerable amount of power. FARAD (Faraday Accelerator with Radio-Frequency Assisted Discharge) ionizes gas before it is exposed to the magnetic field, greatly reducing the required pulse energy, allowing for a much smaller thruster.",
    "default_config": "FARAD",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Electric_Engine_Configs/FARAD_Config.cfg",
