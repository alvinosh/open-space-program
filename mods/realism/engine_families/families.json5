  {
    "id": "Castor-4AXL",
    "title": "Castor 4AXL",
    "manufacturer": "Thiokol",
    "description": "A strap-on booster, improved from the Castor 4A and first tested May 1992. Its 30% performance increase would improve capacity of Atlas IIAS, H-II, and other vehicles. First flight 2001.",
    "default_config": "Castor-4AXL",
    "parts": [
      "ROE-Castor4AXL"
    ],
    "model": "models/engines/ROE-Castor4AXL.glb",
