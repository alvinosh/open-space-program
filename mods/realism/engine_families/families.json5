  {
    "id": "RD58",
    "title": "S1.5400/RD-58 Series",
    "manufacturer": "ОКБ-1 (Korolev)",
    "description": "The world's first closed-cycle engine, the S1.5400 was designed for the Block L stage on the R-7's Molniya configuration to launch communication satellites and interplanetary probes. It was given the industry designation 11D33. The 11D33M model brought additional upgrades, and was used on Molniya-M until 2010. The RD-58 (11D58) was used on the restartable Block D upper stage for the N-1 lunar rocket; this stage was later adapted for Proton, Zenit and Angara, where it is still used today. A variant of the RD-58, designated 17D12, was used as main propulsion system on the Buran orbiter.",
    "default_config": "S1_5400",
    "parts": [
      "ROE-RD58"
    ],
    "model": "models/engines/ROE-RD58.glb",
