  {
    "id": "Castor-2",
    "title": "Castor 2",
    "manufacturer": "Thiokol",
    "description": "A derivative of the Castor 1 motor, the Castor 2 featured higher specific impulse and propellant load, a lower dry mass fraction, and a longer burn time. It was used as strap-on booster starting with Delta E and in all but the early Scouts. Burn time 39s.",
    "default_config": "Castor-2-SL",
