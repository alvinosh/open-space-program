  {
    "id": "RD301",
    "title": "RD-301",
    "manufacturer": "EnergoMash Design Bureau",
    "description": "An exotic fuel-rich staged combustion vacuum engine. Developed as a high-energy upper stage for Proton by Glushko, the RD-301 burned liquid fluorine and ammonia, which gave very high performance and density. It was tested extensively, but never flew due to toxicity concerns.",
    "default_config": "RD-301",
    "parts": [
