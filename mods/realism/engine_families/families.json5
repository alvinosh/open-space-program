    "title": "TF/CF34 High-Bypass Turbofan",
    "manufacturer": "General Electric (GE)",
    "description": "The TF34 is a 1970s high-bypass turbofan. It powered the S-3, S-72, and A-10, while its civilian derivative, the CF34, powered many large private jets and regional airliners such as the Challenger 600 Series, Challenger 850, CRJ100/200/440/700/900, and the Embraer 170/175/190/195.",
    "default_config": "CF34-1A",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/CF34_Config.cfg"
  },
  {
    "id": "CF6",
    "title": "CF6 High-Bypass Turbofan",
    "manufacturer": "General Electric (GE)",
    "description": "The CF6 high-bypass turbofan was developed from the TF39, the first ever production high-bypass turbofan. It powered many large aircraft, including the A300, A310, A330, B747, B767, DC-10, KC-10, MD-11, E-4, C-2, and C-5M.",
    "default_config": "CF6-6",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/CF6_Config.cfg"
  },
  {
    "id": "CFM56",
    "title": "CFM56 High-Bypass Turbofan",
    "manufacturer": "CFM International",
    "description": "The CFM56 is a 1970s high-bypass turbofan, developed from the F101. Created in a collaboration between GE and Snecma, the CFM56 is the most successful high-bypass turbofan ever made, with over 30,000 built. It powered the Airbus A320 and A340 series, B737 Classic and Next Gen series, DC-8-70, and was used to re-engine many 707-based aircraft such as the E-3, E-6, and KC/RC-135.",
    "default_config": "CFM56-5B3",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/CFM56_Config.cfg"
  },
  {
    "id": "Chimera",
    "title": "Chimera Combined Cycle Ramjet",
    "manufacturer": "Hermeus",
    "description": "The Chimera is a combined cycle ramjet tech demonstrator built by Hermeus. Based around retired J85 cores, it is intended to operate over a flight envelope from Mach 0 to Mach 5.",
    "default_config": "J85-GE-21-Chimera",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/Chimera_Config.cfg"
  },
  {
    "id": "D18",
    "title": "D-18 High-Bypass Turbofan",
    "manufacturer": "Ivchenko-Progress ZMKB",
    "description": "The D-18 was the largest high-bypass turbofan developed in the Soviet Union, created in the 1980s for the An-124 and An-225.",
    "default_config": "D-18T",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/D18_Config.cfg"
  },
  {
    "id": "D27",
    "title": "#roD27Title",
    "manufacturer": "Ivchenko-Progress ZMKB",
    "description": "#roD27Desc",
    "default_config": "D-27",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/D27_Config.cfg"
  },
  {
    "id": "D30",
    "title": "D-30 Low-Bypass Turbofan",
    "manufacturer": "Soloviev Design Bureau",
    "description": "The D-30 is one of the first turbofan engines developed in the Soviet Union, and the most successful. While originally developed to power the Tu-134 airliner, it found its way into many Soviet aircraft, including the Tu-154, Il-62, Il-76, M-55, and with afterburner, MiG-31 and Su-47.",
    "default_config": "D-30F6",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/D30_Config.cfg"
  },
  {
    "id": "DS215",
    "title": "DS-215 Electric Ducted Fan",
    "manufacturer": "Schubeler",
    "description": "A large, 16 kW electric ducted fan. Very powerful for it's size, but fixed pitch propeller blades limit it to low speeds.",
    "default_config": "DS-215",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/DS215_Config.cfg"
  },
  {
    "id": "Derwent",
    "title": "Derwent Turbojet",
    "manufacturer": "Rolls-Royce",
    "description": "The Derwent was a development of the W.2 / Welland engine with \"straight through flow\" rather than \"reverse flow,\" leading to an increase in thrust and efficiency. It was a short-lived line of engines, ending with World War II; indeed, the Derwent V was in fact a scaled-down Nene. Powered the Meteor F.3/F.4/NF.12/NF.14, Nord 1601, Sagittario II, and Yak-23/25/30 and La-15 as the license-built RD-500.",
    "default_config": "DerwentV",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/Derwent_Config.cfg"
  },
  {
    "id": "EJ200",
    "title": "EJ200 Low-Bypass Turbofan",
    "manufacturer": "EuroJet Turbo",
    "description": "The EJ200 is a 1990s low-bypass turbofan, designed as a joint venture between many European companies for the Eurofighter Typhoon.",
    "default_config": "EJ200-100",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/EJ200_Config.cfg"
  },
  {
    "id": "F100",
    "title": "F100 Low-Bypass Turbofan",
    "manufacturer": "Pratt & Whitney",
    "description": "The F100 is a 1970s low-bypass turbofan designed for the F-15 and F-16. Its advanced design and high power allowed the F-15 and F-16 to achieve a thrust to weight ratio greater than one. It was used in all F-15 and most F-16 variants.",
    "default_config": "F100-PW-100",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/F100_Config.cfg"
  },
  {
    "id": "F119",
    "title": "F119 Low-Bypass Turbofan",
    "manufacturer": "Pratt & Whitney",
    "description": "The F119 is a 1990s low-bypass turbofan designed for the Advance Tactical Fighter program. Designed for supercruise capability, it has unusually high dry thrust for its size, and it has a 2D thrust-vectoring nozzle for increased maneuverability. It was used in the F-22, YF-23, X-32 and X-35.",
    "default_config": "F119-PW-100",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/F119_Config.cfg"
  },
  {
    "id": "F135",
    "title": "F135 Low-Bypass Turbofan",
    "manufacturer": "Pratt & Whitney",
    "description": "The F135 is a 2000s low-bypass turbofan designed for the F-35. Two variants exist, with a conventional nozzle for the F-35A/C, and one with a forward PTO shaft and gimbaled nozzle for the VTOL-capable F-35B.",
    "default_config": "F135-PW-100",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/F135_Config.cfg"
  },
  {
    "id": "F404",
    "title": "F404 Low-Bypass Turbofan",
    "manufacturer": "General Electric (GE)",
    "description": "The F404 is a 1970s low-bypass turbofan designed for the F/A-18. It was designed for reliability rather than performance, in order to replace the notoriously unreliable F-4s and F-14s used by the US Navy and Marines at the time. It was used in the F/A-18A/B/C/D, F-20A, F-117A, T-7A, T-50, JAS-39, and Tejas.",
    "default_config": "F404-GE-400",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/F404_Config.cfg"
  },
  {
    "id": "GE4",
    "title": "GE4 Turbojet",
    "manufacturer": "General Electric (GE)",
    "description": "The GE4 was a 1970s turbojet developed to power the Boeing 2707 supersonic transport at speeds up to Mach 2.7. The most powerful turbojet ever made, the GE4 was tested extensively, but ultimately cancelled with the rest of the 2707 project.",
    "default_config": "GE4-J5P",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/GE4_Config.cfg"
  },
  {
    "id": "GEnx",
    "title": "GEnx High-Bypass Turbofan",
    "manufacturer": "General Electric (GE)",
    "description": "The GEnx is a 2000s large, high-bypass turbofan, developed from the GE90 to power the B787. It is used in most 787 variants, as well as in the 747-8.",
    "default_config": "GEnx-2B67B",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/GEnx_Config.cfg"
  },
  {
    "id": "J35",
    "title": "J35 Turbojet",
    "manufacturer": "Allison Engine",
    "description": "The Allison/General Electric J35 is an axial flow turbojet, and one of the first turbojets natively designed in the United States. Although not as well known as its later derivative, the J47, it still powered many late 40s aircraft such as the FJ-1, F-84, F-89, XP-86, XB-45, XB-47, X-5, and D-558.",
    "default_config": "J35-A-11",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/J35_Config.cfg"
  },
  {
    "id": "J48",
    "title": "J48/Tay Turbojet",
    "manufacturer": "Pratt & Whitney",
    "description": "The J48 was also known as the Rolls-Royce Tay. Essentially an enlarged Nene, it was abandoned by Rolls-Royce in favor of the Avon. However, Pratt & Whitney was able to acquire the design, and produced it as the J48. It was used in the F9F-5 Panther, F9F-6/8 Cougar, F-94C Starfire, and YF-93.",
    "default_config": "J48-P-5",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/J48_Config.cfg"
  },
  {
    "id": "J79",
    "title": "J79 Turbojet",
    "manufacturer": "General Electric (GE)",
    "description": "The first US \"Mach 2\" engine, the J79 saw extensive service, powering the B-58, F-4, A-5, and F-104.",
    "default_config": "J79-GE-3A",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/J79_Config.cfg"
  },
  {
    "id": "J85",
    "title": "J85 Turbojet",
    "manufacturer": "General Electric (GE)",
    "description": "The J85 was developed as a small, disposable jet engine to power decoys and drones, but was later upgraded for use on manned aircraft. It powered many small aircraft, including the F-5, CF-5, G.91Y, T-2, T-38, and A-37.",
    "default_config": "J85-GE-4",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/J85_Config.cfg"
  },
  {
    "id": "J93",
    "title": "J93 Turbojet",
    "manufacturer": "General Electric (GE)",
    "description": "Derived from the J79, the J93 was developed for Mach 3 performance to power the B-70 and F-108.",
    "default_config": "J93-GE-3",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/J93_Config.cfg"
  },
  {
    "id": "JT8D",
    "title": "JT8D Low-Bypass Turbofan",
    "manufacturer": "Pratt & Whitney",
    "description": "Derived from the J52, the JT8D was an early low-bypass turbofan, used on many second-generation jetliners like the Boeing 727, 737, and DC-9. It received a substantial redesign in the 1970s, creating the JT8D-200 series, which powered the Super 27, MD-80 series, and was used to upgrade many 707-based aircraft like the E-8C.",
    "default_config": "JT8D-219",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/JT8D_Config.cfg"
  },
  {
    "id": "JTF17",
    "title": "#roJTF17Title",
    "manufacturer": "Pratt & Whitney",
    "description": "#roJTF17Desc",
    "default_config": "JTF17A-21L",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/JTF17_Config.cfg"
  },
  {
    "id": "Model304",
    "title": "Model 304 Turbojet",
    "manufacturer": "Pratt & Whitney",
    "description": "A late 50s turbojet based on the Pratt & Whitney J57, the Model 304-2 was a liquid-hydrogen-fueled turbojet, designed for project SUNTAN, a high-performance replacement for the U-2 spyplane. The project required the development of large-scale liquid hydrogen production and handling techniques, at the cost of hundreds of millions of dollars. Various jet engines were converted to hydrogen power, where they showed incredible stability and efficiency. This information, along with many of the engineers involved, were later transferred to working on the RL-10 where the information gained proved invaluable. The Model 304 and project SUNTAN, however, were ultimately cancelled, as the conventionally-fueled A-12/SR-71 was showing much greater promise.",
    "default_config": "Model304-2",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/Model304_Config.cfg"
  },
  {
    "id": "NK12",
    "title": "NK-12 Turboprop",
    "manufacturer": "ОКБ-276 (Kuznetsov)",
    "description": "The NK-12 was a large 1950s turboprop. Created to power the Tu-95, it is the largest turboprop to enter production. It powered the A-90, An-22, Tu-95, Tu-114, Tu-116, Tu-126, and Tu-142.",
    "default_config": "NK-12",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/NK12_Config.cfg"
  },
  {
    "id": "NK22",
    "title": "NK-22/144 Low-Bypass Turbofan",
    "manufacturer": "NPO Kuznetsov",
    "description": "The NK-144 was a 1960s low-bypass turbofan developed from the NK-8 to power the Tu-144 supersonic transport. The NK-144 was unable to meet performance requirements and was replaced by the RD-36, but found new life as the NK-22, which powered the Tu-22M0/M1/M2.",
    "default_config": "NK-144",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/NK22_Config.cfg"
  },
  {
    "id": "NK25",
    "title": "NK-25/32 Low-Bypass Turbofan",
    "manufacturer": "NPO Kuznetsov",
    "description": "The NK-25 was a 1970s low-bypass turbofan, developed from the earlier NK-22. It is the most powerful supersonic jet engine ever flown, and was used to power the Tu-22M3, Tu-160, Tu-160M and Tu-144LL.",
    "default_config": "NK-25",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/NK25_Config.cfg"
  },
  {
    "id": "NK8",
    "title": "NK-8 Low-Bypass Turbofan",
    "manufacturer": "NPO Kuznetsov",
    "description": "The NK-8 was a 1960s low-bypass turbofan, created to power the Il-62 and Tu-154. It was later modified for improved performance to power the Il-86, and modified to run on alternate fuels for the Tu-155 project. It powered the A-90, Il-62, Il-62M, Tu-154, Tu-154A/B and Tu-155.",
    "default_config": "NK-8",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/NK8_Config.cfg"
  },
  {
    "id": "Nord1500",
    "title": "Nord 1500/Atar Combined Cycle Ramjet",
    "manufacturer": "Nord-Aviation",
    "description": "The Nord 1500 ramjet was a combined cycle ramjet, mated to an Atar 101E. Used on the Griffon II experimental aircraft, the Atar 101 would accelerate the aircraft up to the speed of sound, at which point the ramjet could act as a thrust augmentor and accelerate aircraft up to speeds over Mach 2. Although the Griffon II performed well, it was cancelled in favor of more conventional aircraft.",
    "default_config": "Atar101E-3",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/Nord1500_Config.cfg"
  },
  {
    "id": "Olympus593",
    "title": "Olympus 593 Turbojet",
    "manufacturer": "Rolls-Royce",
    "description": "A late 1960s turbojet. The ultimate version of the Olympus turbojet, designed for sustained Mach 2 operation to power Concorde. Although thirsty at sea level, when mated to a well-optimized intake this engine can supercruise at Mach 2, achieving relatively good efficiency.",
    "default_config": "Olympus593-610",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/Olympus593_Config.cfg"
  },
  {
    "id": "PT6A",
    "title": "PT6A Turboprop",
    "manufacturer": "Pratt & Whitney Canada",
    "description": "An early 1960s small turboprop. Developed for midsize general aviation aircraft, the PT6A was first used on the Beechcraft King Air. It's low cost, low weight, and high reliability led to it becoming one of the most popular turboprop engines ever, with over 60,000 built. It is offered in many large general aviation and small commercial aircraft, and is popular as an upgrade to older piston-engined aircraft.",
    "default_config": "PT6A-6A",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/PT6A_Config.cfg"
  },
  {
    "id": "R11",
    "title": "R-11 Turbojet",
    "manufacturer": "ОКБ-300 (Tumansky)",
    "description": "A late 50s turbojet, the R-11 was developed in parallel with the less sophisticated RD-9. It became the powerplant for the MiG-21, Yak-28 and Su-15. It was reverse-engineered in China and built as the WP-7, where it powered the JJ-7, J/F-7, and J-8.",
    "default_config": "R-11F-300",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/R11_Config.cfg"
  },
  {
    "id": "R13",
    "title": "R-13 Turbojet",
    "manufacturer": "MNZ Soyuz",
    "description": "A late 60s turbojet, the R-13 was developed from the earlier R-11 to improve the performance of the MiG-21. It became the powerplant for late model MiG-21s and Su-15s. It was reverse-engineered in China and built as the WP-13, where it powered the J-7III onwards and J-8II.",
    "default_config": "R-13-300",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/R13_Config.cfg"
  },
  {
    "id": "R15",
    "title": "R-15 Turbojet",
    "manufacturer": "ОКБ-300 (Tumansky)",
    "description": "A late 50s turbojet originally developed for the Tu-121 cruise missile, the R-15 was modified instead for use on the MiG-25, which became the fastest serially produced fighter, capable of reaching Mach 3.2, although at the risk of severe engine damage.",
    "default_config": "R-15B-300",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/R15_Config.cfg"
  },
  {
    "id": "R25",
    "title": "R-25 Turbojet",
    "manufacturer": "MNZ Soyuz",
    "description": "A late 60s turbojet. Developed to replace the R-11 and R-13, the R-25 added an extremely powerful \"extra-power\" afterburner, that allowed it to nearly double it's thrust for short periods of time.",
    "default_config": "R-25-300",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/R25_Config.cfg"
  },
  {
    "id": "R79",
    "title": "R-79 Turbofan",
    "manufacturer": "MNZ Soyuz",
    "description": "A 1980s afterburning turbofan, designed for the Yak-41. It was equipped with an engine gimbal system that allowed the nozzle to rotate 95 degrees, to support vertical flight, and was the first engine of this type equipped with an afterburner, allowing the Yak-41 to achieve supersonic flight. It powered the Yak-141/41, and was proposed to power the Su-47 with the thrust vectoring system removed.",
    "default_config": "R-79-300",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/R79_Config.cfg"
  },
  {
    "id": "RB162",
    "title": "RB.162 Turbojet",
    "manufacturer": "Rolls-Royce",
    "description": "The RB.162 was a lightweight turbojet, designed to be used as a liftjet for VTOL aircraft. It utilized fiberglass and plastic extensively in it's construction to reduce weight as much as possible, resulting in a low lifetime but very high thrust-to-weight ratio. It was used as a liftjet on the Do-31, Mirage IIIV, and VAK 191B, and as a booster engine on the Trident 3B to improve takeoff performance.",
    "default_config": "RB162-4D",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RB162_Config.cfg"
  },
  {
    "id": "RD012",
    "title": "RD-012 Ramjet",
    "manufacturer": "ОКБ-670 (Bondaryuk)",
    "description": "The RD-012 was a supersonic ramjet, designed to power the La-350 Burya cruise missile up to Mach 3.1.",
    "default_config": "RD-012U",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RD012_Config.cfg"
  },
  {
    "id": "RD36",
    "title": "RD-36 Turbojet",
    "manufacturer": "Rybinsk Motor Design Bureau (РКБМ)",
    "description": "The RD-36 was a 1970s turbojet, developed to power the Tu-144. The RD-36 replaced the underperforming NK-144 engines, allowing the Tu-144 to achieve its intended range. Ultimately, the Tu-144 was taken out of service shortly after being upgraded due to costs. The RD-36 powered the Tu-144D and M-17.",
    "default_config": "RD-36-51A",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RD36_Config.cfg"
  },
  {
    "id": "RD41",
    "title": "RD-41 Turbojet",
    "manufacturer": "Rybinsk Motor Design Bureau (РКБМ)",
    "description": "The RD-41 was a lightweight turbojet, designed as an improved version of the RD-36 liftjet for the Yak-141/41M. It was provided with a gimballing engine mount, allowing for 12.5 degrees of deflection to improve stability while hovering. Used as the liftjet on the Yak-141/41M.",
    "default_config": "RD-41",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RD41_Config.cfg"
  },
  {
    "id": "RD9",
    "title": "RD-9 Turbojet",
    "manufacturer": "ОКБ-300 (Tumansky)",
    "description": "An early 50s turbojet. Developed as a scaled down Mikulin AM-3, the RD-9 was designed for fighter aircraft and powered the Yak-25, 26, 27, 28, and MiG-19. It was license-built in China as the WP-6, where it powered the JJ-6, J/F-6, Q/A-5, and J-12.",
    "default_config": "RD-9B",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RD9_Config.cfg"
  },
  {
    "id": "RJ43",
    "title": "RJ43 Ramjet",
    "manufacturer": "Marquardt",
    "description": "The RJ43 was a supersonic ramjet, designed to power the CIM-10 Bomarc surface to air missile at speeds up to Mach 3. It was also used on the X-7 and XQ-5/AQM-60 target drone, and was modified to power the D-21 up to speeds over Mach 3.3.",
    "default_config": "RJ43-MA-3",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RJ43_Config.cfg"
  },
  {
    "id": "RJ47",
    "title": "RJ47 Ramjet",
    "manufacturer": "Curtiss-Wright",
    "description": "The RJ47 was a supersonic ramjet, designed to power the SM-64 Navaho cruise missile up to Mach 2.75.",
    "default_config": "XRJ47-W-5",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RJ47_Config.cfg"
  },
  {
    "id": "RJ55",
    "title": "RJ55/J67 Combined Cycle Ramjet",
    "manufacturer": "Curtiss-Wright",
    "description": "The RJ55 was a combined cycle ramjet, mated to a J67. At low speeds, the RJ55 functioned as an afterburner for the J67 turbojet, but at mach 2.24 the turbojet would be shut down and the RJ55 would power the aircraft up to Mach 3. Designed for the XF-103, but difficuties with the J67 turbojet meant the prototype never flew under it's own power.",
    "default_config": "J67-W-3",
    "source": "KSP-RO/RealismOverhaul/GameData/RealismOverhaul/Engine_Configs/Jet_Engine_Configs/RJ55_Config.cfg"
  },
  {
    "id": "RJ59",
    "title": "RJ59 Ramjet",
    "manufacturer": "Marquardt",
