  {
    "id": "Castor-30XL",
    "title": "Castor 30XL",
    "manufacturer": "Alliant Techsystems (ATK)",
    "description": "The CASTOR 30XL is more than a stretched version of the CASTOR 30. The motor is 235.8 inches long and designed to function as a second or third stage depending on vehicle configuration. The nozzle is 8 feet long and submerged, with a high expansion ratio (55.9:1), a dual density exit cone for high altitude operation, and an electro-mechanical TVA system.",
    "default_config": "Castor-30XL",
