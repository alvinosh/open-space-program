// Real engines, capsules, tanks, batteries and the RP-1 tech tree, from the Realism Overhaul
// and RP-1 mods for KSP (scripts/raw_space_data), with historical craft and launches.
// Most records are generated by scripts/realism/import_realism.py; craft/, scenarios/ and
// launch_sites/ are written by hand.
{
  id: "realism",
  name: "Realism: RO/RP-1 parts and history",
  version: "0.1.0",
  authors: ["Realism Overhaul and RP-1 contributors (data)", "Open Space Program"],
  description: "Every Realism Overhaul engine config, the RO capsules, RealFuels tanks and batteries, the RP-1 tech tree with historical dates, and historical rockets.",
  dependencies: ["core"],
}
