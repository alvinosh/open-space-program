// Engines. Masses in kg, thrust in N, Isp in s, gimbal_range in degrees.
// `propellants` maps resource -> mass ratio (normalised at load), so patches can change one entry.
// `min_throttle` is the lowest thrust share a running engine holds (throttle settings below it
// run at the floor). `response` is how the thrust follows the throttle, in seconds:
// `spool_up` from ignition to full thrust along the `startup` curve ([time share, thrust
// share] points), `spool_down` from cutoff to 1% thrust, `throttle_time` to sweep 0 to 100%.
// Stock engines are simple: they start and stop at once, throttle to nothing and light whenever
// asked, however many times. The Realistic Engines mod (mods/realistic_engines) gives them their
// start-ups, throttle floors, ignition limits and need for settled propellant.
// `exit_pressure` (Pa, at full thrust) shapes the plume against the ambient pressure: well
// below it (an overexpanded sea-level engine) the jet ends its shock cells in bright Mach
// disks. The plume looks like the `plumes` record for what the engine burns, or the one
// `plume` names. An open-cycle (gas-generator) engine's `turbine_exhaust` leaves through a
// pipe of its own (`{ pipe: { exit: [x, y, z], diameter } }`, the outlet's centre in the
// model's axes from the gimbal pivot, nozzle down -y, m) or into the nozzle (`"nozzle"`),
// and shows beside its plume.
// `length` (gimbal pivot to nozzle exit) and `exit_diameter` in m size the engine on the
// rocket; `model` is a glTF file relative to the mod root with its origin at the gimbal
// pivot and the nozzle pointing down. Without a model a plain bell of that size is drawn.
[
  {
    id: "K-1 Booster", // Merlin 1D-class gas-generator kerolox
    mass: 470,
    thrust_vac: 914000,
    isp_vac: 311,
    isp_sl: 282,
    min_throttle: 0,
    exit_pressure: 70000,
    gimbal_range: 5,
    // The gas generator's exhaust leaves through a pipe beside the bell.
    turbine_exhaust: { pipe: { exit: [0.385, -1.5, 0.0], diameter: 0.15 } },
    propellants: { "Liquid Fuel": 1.0, Oxidiser: 2.36 },
    length: 2.5,
    exit_diameter: 0.9,
    model: "models/engines/k1_booster.glb",
  },
  {
    id: "K-1 Vacuum", // vacuum-optimised kerolox upper stage engine
    mass: 490,
    thrust_vac: 981000,
    isp_vac: 348,
    isp_sl: 100,
    min_throttle: 0,
    exit_pressure: 4000,
    gimbal_range: 5,
    // The gas generator's exhaust cools the nozzle extension.
    turbine_exhaust: "nozzle",
    propellants: { "Liquid Fuel": 1.0, Oxidiser: 2.36 },
    length: 4.0,
    exit_diameter: 3.0,
    model: "models/engines/k1_vacuum.glb",
  },
  {
