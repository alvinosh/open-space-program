// A small satellite: a cylindrical bus with a solar array out to each side, cold-gas RCS
// around its top and the nitrogen for it in a bottle. With the arrays out, its three
// moments of inertia all differ: smallest about pitch (the axis along the arrays), largest
// about yaw, and in between about roll, the bus's long axis. Spun about that middle axis it
// cannot keep spinning steadily (the Dzhanibekov effect; see the `dzhanibekov` scenario).
{
  id: "satellite",
  name: "Satellite",
  stages: [
    {
      name: "Bus",
      // Structure, avionics, batteries and payload.
      structure_mass: 550,
      diameter: 2.0,
      length: 4.0,
      tanks: [{ type: "COPV", shape: "sphere", diameter: 0.8, propellants: { Nitrogen: 1 } }],
      rcs: ["Cold Gas Quad", "Cold Gas Quad", "Cold Gas Quad", "Cold Gas Quad"],
      wings: [
        {
          // Flat panels across the middle of the bus.
          name: "Solar array",
          position: 2.8,
          root_chord: 1.6,
          tip_chord: 1.6,
          span: 6.0,
          thickness: 0.02,
          mass: 120,
          mirror: true,
        },
      ],
    },
  ],
  sequences: [],
}
