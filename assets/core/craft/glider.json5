// A two-part sailplane: a slim tail boom carrying the tailplane and fin, tapering up into
// the cabin, which carries the wing. Stages are listed from the bottom, so the tail comes
// first. Nothing separates (`sequences: []`). Stick: pitch (elevator), yaw (rudder) and
// roll (ailerons); trimmed to glide hands off at about 38 m/s.
{
  id: "glider",
  name: "Kestrel",
  stages: [
    {
      name: "Tail boom",
      structure_mass: 45,
      diameter: 0.3,
      length: 4.5,
      wings: [
        {
          name: "Tailplane",
          position: 0.9,
          root_chord: 0.6,
          tip_chord: 0.4,
          span: 1.3,
          sweep: 0.15,
          incidence: -1.5,
          thickness: 0.1,
          mass: 12,
          mirror: true,
          control: { axes: ["pitch"], chord: 0.3, deflection: 15 },
        },
        {
          name: "Fin",
          position: 1.1,
          angle: 270,
          root_chord: 0.9,
          tip_chord: 0.5,
          span: 1.1,
          sweep: 0.4,
          thickness: 0.1,
          mass: 8,
          control: { axes: ["yaw"], chord: 0.35, deflection: 20 },
        },
      ],
    },
    {
      name: "Cabin",
      // Pilot, seat, canopy, instruments and the fuselage around them.
      structure_mass: 330,
      diameter: 0.9,
      length: 3.0,
      wings: [
        {
          name: "Wing",
          position: 1.1,
          root_chord: 1.0,
          tip_chord: 0.45,
          span: 7.0,
          sweep: 0.15,
          dihedral: 3,
          incidence: 1.5,
          thickness: 0.15,
          mass: 160,
          mirror: true,
          control: { axes: ["roll"], chord: 0.22, span: [0.55, 0.95], deflection: 15 },
        },
      ],
    },
  ],
  sequences: [],
}
