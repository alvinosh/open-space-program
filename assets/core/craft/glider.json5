// A sailplane that rockets off a runway: a slim tail boom carrying the tailplane and fin,
// tapering up into the cabin, which carries the wing. It takes off from a dolly of three
// wheels (nose and main) and two solid rocket boosters either side of the tail boom, and
// lets all three go: Space lights the boosters (they burn about eleven seconds, enough
// for 70 m/s), the next press drops them, the one after drops the dolly. Dropped, it glides
// hands off at about 38 m/s. Stick: pitch (elevator), yaw (rudder) and roll (ailerons); B
// holds the brakes. Built by hand.
{
  id: "glider",
  name: "Kestrel",
  parts: [
    {
      id: "cabin",
      name: "Cabin",
      shape: {
        compound: [
          {
            name: "skin",
            shape: {
              revolved: {
                walls: [
                  {
                    name: "aft_skirt",
                    curve: { start: [0.45, 0], segments: [{ line: [0.45, 3] }] },
                  },
                  {
                    name: "floor",
                    curve: { start: [0, 0], segments: [{ line: [0.45, 0] }] },
                  },
                ],
              },
            },
          },
          {
            name: "equipment",
            shape: { ring: { diameter: 0.9, height: 3, thickness: 0.45 } },
            unseen: true,
          },
        ],
      },
      // Pilot, seat, canopy, instruments and the fuselage around them.
      structure: { thickness: 0, mass: 330 },
      components: [{ container: {} }],
      nodes: [
        { name: "bottom", position: [0, 0, 0], direction: [0, 0, -1], size: 0.9 },
        { name: "top", position: [0, 0, 3], direction: [0, 0, 1], size: 0.9 },
        { name: "belly", position: [0, 0.45, 1.5], direction: [0, 1, 0], size: 0.16 },
        {
          name: "wing_1",
          position: [0.45, 0, 1.1],
          direction: [0.999999061395, -0.000017909647, 0.001369995621],
          size: 1,
        },
        {
          name: "wing_1_left",
          position: [-0.45, 0, 1.1],
          direction: [-0.999999061395, -0.000017909647, 0.001369995621],
          size: 1,
        },
      ],
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    // A tangent-ogive nose, 1.3 diameters long.
    {
      id: "cabin_shell_1",
      name: "Nose cone",
      on: "cabin.top",
      shape: {
        shell: {
          bottom_diameter: 0.9,
          sections: [{ length: 1.17, top_diameter: 0, profile: "ogive" }],
        },
      },
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    {
      id: "cabin_wing_1",
      name: "Wing",
      on: "cabin.wing_1",
      by: "root",
      roll: 1.497943834,
      shape: {
        wing: {
          root_chord: 1,
          tip_chord: 0.45,
          span: 6.9904067432820165,
          sweep: 0.15,
          dihedral: 3,
          airfoil: { naca: { thickness: 0.15 } },
        },
      },
      structure: { mass: 80 },
      components: [
        {
          lifting_surface: {
            control: { axes: ["roll"], chord: 0.22, span: [0.55, 0.95], deflection: 15 },
          },
        },
      ],
      paint: { color: [0.8600000143051147, 0.8600000143051147, 0.8399999737739563] },
    },
    {
      id: "cabin_wing_1_left",
      name: "Wing",
      on: "cabin.wing_1_left",
      by: "root",
      roll: -1.497943834,
      shape: {
        mirrored: {
          wing: {
            root_chord: 1,
            tip_chord: 0.45,
            span: 6.9904067432820165,
            sweep: 0.15,
            dihedral: 3,
            airfoil: { naca: { thickness: 0.15 } },
          },
        },
      },
      structure: { mass: 80 },
      components: [
        {
          lifting_surface: {
            control: { axes: ["roll"], chord: 0.22, span: [0.55, 0.95], deflection: 15 },
          },
        },
      ],
      paint: { color: [0.8600000143051147, 0.8600000143051147, 0.8399999737739563] },
    },
    {
      id: "tail_boom",
      name: "Tail boom",
      on: "cabin.bottom",
      by: "top",
      shape: {
        compound: [
          {
            name: "skin",
            shape: {
              revolved: {
                walls: [
                  // Slim past the tail, then flaring out to the cabin.
                  {
                    name: "aft_skirt",
                    curve: {
                      start: [0.15, 0],
                      segments: [{ line: [0.15, 1.2] }, { line: [0.45, 4.44] }],
                    },
                  },
                  {
                    name: "separation_ring",
                    curve: { start: [0.45, 4.44], segments: [{ line: [0.45, 4.5] }] },
                  },
                  {
                    name: "floor",
                    curve: { start: [0, 0], segments: [{ line: [0.15, 0] }] },
                  },
                ],
              },
            },
          },
          {
            name: "equipment",
            shape: { ring: { diameter: 0.3, height: 4.5, thickness: 0.15 } },
            unseen: true,
          },
        ],
      },
      structure: { thickness: 0, mass: 45 },
      components: [{ container: {} }, { decoupler: { node: "top" } }],
      nodes: [
        { name: "bottom", position: [0, 0, 0], direction: [0, 0, -1], size: 0.3 },
        { name: "top", position: [0, 0, 4.5], direction: [0, 0, 1], size: 0.9 },
        { name: "wing_1", position: [0.15, 0, 0.9], direction: [1, 0, 0], size: 0.6 },
        {
          name: "wing_1_left",
          position: [-0.15, 0, 0.9],
          direction: [-1, 0, 0],
          size: 0.6,
        },
        { name: "wing_2", position: [0, -0.15, 1.1], direction: [0, -1, 0], size: 0.9 },
        { name: "booster_right", position: [0.46, 0, 3.85], direction: [1, 0, 0], size: 0.24 },
        { name: "booster_left", position: [-0.46, 0, 3.85], direction: [-1, 0, 0], size: 0.24 },
      ],
      paint: {
        color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995],
        pieces: {
          "skin/separation_ring": {
            color: [0.550000011920929, 0.550000011920929, 0.5699999928474426],
            finish: "metal",
          },
        },
      },
    },
    {
      id: "tail_boom_wing_1",
      name: "Tailplane",
      on: "tail_boom.wing_1",
      by: "root",
      roll: -1.5,
      shape: {
        wing: {
          root_chord: 0.6,
          tip_chord: 0.4,
          span: 1.3,
          sweep: 0.15,
          airfoil: { naca: { thickness: 0.1 } },
        },
      },
      structure: { mass: 6 },
      components: [
        {
          lifting_surface: {
            control: { axes: ["pitch"], chord: 0.3, span: [0, 1], deflection: 15 },
          },
        },
      ],
      paint: { color: [0.8600000143051147, 0.8600000143051147, 0.8399999737739563] },
    },
    {
      id: "tail_boom_wing_1_left",
      name: "Tailplane",
      on: "tail_boom.wing_1_left",
      by: "root",
      roll: 1.5,
      shape: {
        mirrored: {
          wing: {
            root_chord: 0.6,
            tip_chord: 0.4,
            span: 1.3,
            sweep: 0.15,
            airfoil: { naca: { thickness: 0.1 } },
          },
        },
      },
      structure: { mass: 6 },
      components: [
        {
          lifting_surface: {
            control: { axes: ["pitch"], chord: 0.3, span: [0, 1], deflection: 15 },
          },
        },
      ],
      paint: { color: [0.8600000143051147, 0.8600000143051147, 0.8399999737739563] },
    },
    {
      id: "tail_boom_wing_2",
      name: "Fin",
      on: "tail_boom.wing_2",
      by: "root",
      shape: {
        wing: {
          root_chord: 0.9,
          tip_chord: 0.5,
          span: 1.1,
          sweep: 0.4,
          airfoil: { naca: { thickness: 0.1 } },
        },
      },
      structure: { mass: 8 },
      components: [
        {
          lifting_surface: {
            control: { axes: ["yaw"], chord: 0.35, span: [0, 1], deflection: 20 },
          },
        },
      ],
      paint: { color: [0.8600000143051147, 0.8600000143051147, 0.8399999737739563] },
    },
    // A RATO bottle on the tail boom's right, its nozzle just behind the wing's trailing
    // edge and level with the centre of mass, so its thrust does not pitch the nose.
    {
      id: "booster_right",
      name: "RATO booster",
      on: "tail_boom.booster_right",
      by: "side",
      shape: {
        shell: {
          bottom_diameter: 0.24,
          sections: [
            { length: 0.65 },
            { length: 0.3, top_diameter: 0, profile: "ogive" },
          ],
          cap_bottom: true,
        },
      },
      structure: { mass: 4 },
      components: [{ container: {} }, { decoupler: { node: "side" } }],
      nodes: [
        { name: "side", position: [-0.12, 0, 0.5], direction: [-1, 0, 0], size: 0.24 },
        { name: "engine", position: [0, 0, 0], direction: [0, 0, -1], size: 0.1 },
        { name: "tank", position: [0, 0, 0], direction: [0, 0, 1], size: 0.24 },
      ],
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    { id: "booster_right_engine", on: "booster_right.engine", by: "top", template: "S-1" },
    {
      id: "booster_right_grain",
      name: "Solid Grain",
      on: "booster_right.tank",
      shape: { cylinder_tank: { diameter: 0.2, length: 0.35 } },
      components: [{ storage: { type: "Solid Grain", contents: { HTPB: 1 } } }],
    },
    // A RATO bottle on the tail boom's left, its nozzle just behind the wing's trailing
    // edge and level with the centre of mass, so its thrust does not pitch the nose.
    {
      id: "booster_left",
      name: "RATO booster",
      on: "tail_boom.booster_left",
      by: "side",
      shape: {
        shell: {
          bottom_diameter: 0.24,
          sections: [
            { length: 0.65 },
            { length: 0.3, top_diameter: 0, profile: "ogive" },
          ],
          cap_bottom: true,
        },
      },
      structure: { mass: 4 },
      components: [{ container: {} }, { decoupler: { node: "side" } }],
      nodes: [
        { name: "side", position: [0.12, 0, 0.5], direction: [1, 0, 0], size: 0.24 },
        { name: "engine", position: [0, 0, 0], direction: [0, 0, -1], size: 0.1 },
        { name: "tank", position: [0, 0, 0], direction: [0, 0, 1], size: 0.24 },
      ],
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    { id: "booster_left_engine", on: "booster_left.engine", by: "top", template: "S-1" },
    {
      id: "booster_left_grain",
      name: "Solid Grain",
      on: "booster_left.tank",
      shape: { cylinder_tank: { diameter: 0.2, length: 0.35 } },
      components: [{ storage: { type: "Solid Grain", contents: { HTPB: 1 } } }],
    },
    // The dolly it rolls off the runway on, held to the cabin's belly: a slim beam with
    // a nose wheel at its front and the main wheels, splayed to a 1.7 m track, just behind
    // the centre of mass. Dropped once airborne, which leaves the cabin's belly to land on.
    {
      id: "dolly",
      name: "Dolly",
      on: "cabin.belly",
      by: "side",
      shape: {
        shell: { bottom_diameter: 0.16, sections: [{ length: 3 }], cap_bottom: true },
      },
      structure: { mass: 12 },
      components: [{ container: {} }, { decoupler: { node: "side" } }],
      nodes: [
        { name: "side", position: [0, -0.08, 1.6], direction: [0, -1, 0], size: 0.16 },
        { name: "nose_gear", position: [0, 0.08, 2.7], direction: [0, 1, 0], size: 0.06 },
        {
          name: "main_gear",
          position: [0.061283555450, 0.051423008775, 0.2],
          direction: [0.766044443119, 0.642787609687, 0],
          size: 0.06,
        },
        {
          name: "main_gear_left",
          position: [-0.061283555450, 0.051423008775, 0.2],
          direction: [-0.766044443119, 0.642787609687, 0],
          size: 0.06,
        },
      ],
      paint: { color: [0.2, 0.2, 0.21], finish: "metal" },
    },
    {
      id: "nose_gear",
      name: "Nose wheel",
      on: "dolly.nose_gear",
      shape: {
        compound: [
          {
            shape: { beam: { length: 0.7, section: { circle: { diameter: 0.06 } } } },
            rotation: [180, 0, 0],
          },
        ],
      },
      components: [
        {
          gear: { length: 0.7, wheel_radius: 0.18, stroke: 0.15, load: 200, mass: 12, steering: 25 },
        },
      ],
    },
    {
      id: "main_gear",
      name: "Main wheel",
      on: "dolly.main_gear",
      shape: {
        compound: [
          {
            shape: { beam: { length: 1.0, section: { circle: { diameter: 0.06 } } } },
            rotation: [180, 0, 0],
          },
        ],
      },
      components: [
        {
          gear: { length: 1.0, wheel_radius: 0.2, stroke: 0.2, load: 300, mass: 14, brakes: true },
        },
      ],
    },
    {
      id: "main_gear_left",
      name: "Main wheel",
      on: "dolly.main_gear_left",
      shape: {
        compound: [
          {
            shape: { beam: { length: 1.0, section: { circle: { diameter: 0.06 } } } },
            rotation: [180, 0, 0],
          },
        ],
      },
      components: [
        {
          gear: { length: 1.0, wheel_radius: 0.2, stroke: 0.2, load: 300, mass: 14, brakes: true },
        },
      ],
    },
  ],
  sequences: [
    ["engines:booster_right", "engines:booster_left"],
    ["decoupler:booster_right", "decoupler:booster_left"],
    ["decoupler:dolly"],
  ],
}
