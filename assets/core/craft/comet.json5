// An X-1-style rocket plane that takes off from a runway: a kerolox rocket in the tail of
// a bullet fuselage, straight wings, a tailplane and fin, and tricycle landing gear. The
// cockpit (nose gear) is the root, and the fuselage (engine, tank, wings, tail, main gear)
// hangs from it. Nothing separates: the one sequence arms the engine. Stage, throttle up,
// rotate at about 75 m/s; B holds the brakes.
{
  id: "comet",
  name: "Comet",
  parts: [
    {
      id: "cockpit",
      name: "Cockpit",
      shape: {
        compound: [
          {
            name: "skin",
            shape: {
              revolved: {
                walls: [
                  {
                    name: "aft_skirt",
                    curve: { start: [0.7, 0], segments: [{ line: [0.7, 2.5] }] },
                  },
                  {
                    name: "floor",
                    curve: { start: [0, 0], segments: [{ line: [0.7, 0] }] },
                  },
                ],
              },
            },
          },
          {
            name: "equipment",
            shape: { ring: { diameter: 1.4, height: 2.5, thickness: 0.7 } },
            unseen: true,
          },
        ],
      },
      // Pilot, ejection seat, canopy, instruments and the forward fuselage.
      structure: { thickness: 0, mass: 700 },
      components: [{ container: {} }],
      nodes: [
        { name: "bottom", position: [0, 0, 0], direction: [0, 0, -1], size: 1.4 },
        { name: "top", position: [0, 0, 2.5], direction: [0, 0, 1], size: 1.4 },
        { name: "gear_1", position: [0, 0.7, 0.8], direction: [0, 1, 0], size: 0.11 },
      ],
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    // A tangent-ogive nose, 1.3 diameters long.
    {
      id: "cockpit_shell_1",
      name: "Nose cone",
      on: "cockpit.top",
      shape: {
        shell: {
          bottom_diameter: 1.4,
          sections: [{ length: 1.82, top_diameter: 0, profile: "ogive" }],
        },
      },
      paint: { color: [0.8500000238418579, 0.8500000238418579, 0.8299999833106995] },
    },
    {
      id: "cockpit_gear_1",
      name: "Nose gear",
      on: "cockpit.gear_1",
      shape: {
        compound: [
          {
            shape: { beam: { length: 0.838, section: { circle: { diameter: 0.11 } } } },
            rotation: [180, 0, 0],
          },
