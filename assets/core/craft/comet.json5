// An X-1-style rocket plane that takes off from a runway: a kerolox rocket in the tail of
// a bullet fuselage, straight wings, a tailplane and fin, and tricycle landing gear. Stages
// are listed from the bottom, so the fuselage (engine, tank, wings, tail, main gear) comes
// first and the cockpit (nose gear) sits on top. Nothing separates: the one sequence arms
// the engine. Stage, throttle up, rotate at about 75 m/s; B holds the brakes.
{
  id: "comet",
  name: "Comet",
  stages: [
    {
      name: "Fuselage",
      engines: ["R-6"],
      tanks: [
        // Under the wing, near the centre of mass (as in the X-1), so the trim hardly
        // changes as it drains; a feed line runs back to the engine.
        {
          type: "Stiffened Al 2219",
          length: 2.2,
          position: 2.4,
          propellants: { Kerosene: 1, LqdOxygen: 2.3 },
        },
      ],
      structure_mass: 900,
      diameter: 1.4,
      length: 7.0,
      wings: [
        {
          name: "Wing",
          position: 4.1,
          root_chord: 2.0,
          tip_chord: 1.0,
          span: 4.5,
          sweep: 0.3,
          dihedral: 3,
          incidence: 2,
          thickness: 0.1,
          mass: 350,
          mirror: true,
          control: { axes: ["roll"], chord: 0.25, span: [0.5, 0.95], deflection: 15 },
        },
        {
          name: "Tailplane",
          position: 1.3,
          root_chord: 1.25,
          tip_chord: 0.75,
          span: 2.0,
          sweep: 0.35,
          thickness: 0.08,
          mass: 50,
          mirror: true,
          control: { axes: ["pitch"], chord: 0.35, deflection: 25 },
        },
        {
          // Big: the long nose ahead of the centre of mass wants to swing round.
          name: "Fin",
          position: 2.0,
          angle: 270,
          root_chord: 2.0,
          tip_chord: 1.0,
          span: 2.2,
          sweep: 0.9,
          thickness: 0.08,
          mass: 50,
          control: { axes: ["yaw"], chord: 0.35, deflection: 20 },
        },
      ],
      gear: [
        {
          // Splayed out to a 2.3 m track: much narrower and it tips onto a wing.
          name: "Main gear",
          position: 3.6,
          angle: 50,
          length: 1.2,
          wheel_radius: 0.3,
          stroke: 0.25,
          load: 2300,
          mass: 80,
          mirror: true,
          brakes: true,
        },
      ],
    },
    {
      name: "Cockpit",
      // Pilot, ejection seat, canopy, instruments and the forward fuselage.
      structure_mass: 700,
      diameter: 1.4,
      length: 2.5,
      gear: [
        {
          name: "Nose gear",
          position: 0.8,
          length: 0.838,
          wheel_radius: 0.22,
          stroke: 0.2,
          load: 560,
          mass: 40,
          steering: 25,
        },
      ],
    },
  ],
  sequences: [["engines:Fuselage"]],
}
