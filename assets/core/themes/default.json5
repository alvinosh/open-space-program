// Default theme. Every node gets the class named after its widget, then the classes in its
// `class` string, then its inline `style`. Mods restyle the game by patching these classes
// or adding another theme record (all themes are merged in load order).
// Colours: "#rgb", "#rrggbb", "#rrggbbaa" or [r, g, b(, a)] in 0..1.
// `active_*` colours apply while a node's `active` condition holds (selected modes, open
// windows, the current stage).
//
// One look throughout: dark glass surfaces with a hairline border, cool white text, dimmer
// keys with their values lined up on the right, and one green accent for what is on.
// Spacing is on a 4 px grid; screen edges and gaps between modules are 12 and 8 px.
{
  id: "default",
  classes: {
    // --- widget defaults ---
    column: { gap: 2 },
    row: { gap: 8, align_items: "center" },
    spacer: { grow: 1 },
    label: { color: "#e3eaef", font_size: 13 },
    button: {
      padding: [4, 10],
      background: "#1d2a36",
      hover_background: "#2b3e4f",
      active_background: "#2a7350",
      active_color: "#ffffff",
      radius: 4,
      color: "#e8f0f6",
      font_size: 13,
      align_items: "center",
      justify_content: "center",
    },
    bar: { height: 6, min_width: 60, grow: 1, background: [1, 1, 1, 0.07], radius: 3, clip: true },
    bar_fill: { background: "#5fd38a" },
    panel: {
      padding: [8, 10],
      gap: 2,
      background: [0.035, 0.05, 0.065, 0.9],
      radius: 6,
      border: 1,
      border_color: [1, 1, 1, 0.09],
    },
    window: {
      position: "absolute",
      min_width: 240,
      background: [0.035, 0.05, 0.065, 0.93],
      radius: 6,
      border: 1,
      border_color: [1, 1, 1, 0.11],
    },
    window_title: {
      direction: "row",
      gap: 6,
      padding: [5, 6, 5, 10],
      align_items: "center",
      background: [1, 1, 1, 0.04],
      border: [0, 0, 1, 0],
      border_color: [1, 1, 1, 0.07],
    },
    window_title_text: { color: [1, 1, 1, 0.92], font_size: 13 },
    window_content: { padding: [8, 10, 10, 10], gap: 3 },
    window_close: {
      padding: [0, 6],
      background: [0, 0, 0, 0],
      hover_background: "#8f2e2e",
      color: [1, 1, 1, 0.6],
      font_size: 12,
    },

    // --- main menu (see layouts/main_menu.json5) ---
    menu_backdrop: {
      position: "absolute",
      left: 0,
      top: 0,
      width: "100%",
      height: "100%",
      align_items: "center",
      justify_content: "center",
      background: [0.01, 0.015, 0.02, 0.55],
      z_index: 50,
    },
    menu: {
      width: 560,
      max_height: "86vh",
      padding: [22, 24],
      gap: 10,
      background: [0.035, 0.05, 0.065, 0.96],
      radius: 8,
      border: 1,
      border_color: [1, 1, 1, 0.11],
    },
    menu_title: { font_size: 26, color: "#f2f7fa" },
    menu_tab: { padding: [5, 14] },
    menu_page: { gap: 6, shrink: 1, min_height: 0 },
    menu_list: { gap: 6, scroll: true, shrink: 1, min_height: 0 },
    // A choice in a row of them (graphics settings); the selected one is `active`.
    menu_option: { min_width: 52, padding: [3, 6], font_size: 12 },
    menu_item: {
      direction: "column",
      align_items: "start",
      padding: [8, 12],
      gap: 2,
      background: "#16212b",
      hover_background: "#24384a",
      radius: 5,
    },
    menu_item_name: { font_size: 15, color: "#ffffff" },

    // --- docks (see layouts/docks.json5) ---
    // Every `dock` node stacks what is docked into it; `dock_root` places a dock column on
    // the screen.
    dock: { gap: 8 },
    dock_root: { position: "absolute" },
    // Takes the dock's free height and scrolls when its windows do not fit.
    dock_scroll: { grow: 1, shrink: 1, min_height: 0, scroll: true },

    // --- flight modules ---
    // Panels anchored to the screen edges; centred ones set `left: "50%"` and a negative
    // left margin of half their width.
    module: { position: "absolute" },
    launcher: {
      position: "absolute",
      right: 12,
      top: 12,
      direction: "column",
      gap: 2,
      padding: 4,
      width: 96,
      background: [0.035, 0.05, 0.065, 0.9],
      radius: 6,
      border: 1,
      border_color: [1, 1, 1, 0.09],
    },
    launcher_button: {
      padding: [4, 8],
      font_size: 12,
      background: [0, 0, 0, 0],
      hover_background: [1, 1, 1, 0.08],
      active_background: "#2a7350",
      align_items: "start",
    },
    launcher_divider: { height: 1, margin: [3, 2], background: [1, 1, 1, 0.1] },
    readout: { color: "#ffffff", font_size: 26 },
    caption: { color: [1, 1, 1, 0.5], font_size: 11 },
    housing: {
      padding: [8, 12],
      background: [0.035, 0.05, 0.065, 0.9],
      radius: 10,
      border: 1,
      border_color: [1, 1, 1, 0.09],
    },
    navball_bezel: {
      width: 214,
      height: 214,
      radius: 107,
      border: 3,
      border_color: "#2a3846",
      background: "#0a0f14",
      align_items: "center",
      justify_content: "center",
    },
    speed_display: {
      padding: [3, 10],
      background: [0, 0, 0, 0.55],
      hover_background: [1, 1, 1, 0.12],
      color: "#7dff9a",
      font_size: 15,
      radius: 3,
    },
    sas_button: { min_width: 62, padding: [3, 4], font_size: 12 },
    // Small +/- and step buttons (flight plan).
    step_button: { min_width: 30, padding: [2, 6], font_size: 12 },
    value: { min_width: 86, font_size: 13 },
    vbar: { width: 10, min_width: 10, height: 150, grow: 0 },
    thin: { width: 4, min_width: 4 },
    ibar: { width: 84, min_width: 84, grow: 0, height: 5 },
    // RCS propellant gauge under the SAS buttons, as wide as the control bars.
    rcs_bar: { width: 84, min_width: 84, grow: 0 },
    // The sequence stack (layouts/staging.json5).
    seq_row: {
      padding: [3, 6],
      gap: 8,
      min_height: 42,
      radius: 4,
      border: 1,
      border_color: [0, 0, 0, 0],
      hover_background: [1, 1, 1, 0.05],
      active_background: [0.37, 0.83, 0.54, 0.07],
      active_border_color: [0.37, 0.83, 0.54, 0.45],
    },
    seq_number: { min_width: 18, font_size: 15, color: [1, 1, 1, 0.5], active_color: "#ffffff" },
    seq_item: {
      width: 32,
      padding: [2, 0],
      gap: 2,
      align_items: "center",
      radius: 4,
      hover_background: [1, 1, 1, 0.1],
    },
    seq_icon: { width: 26, height: 26, color: "#e3eaef" },
    seq_count: {
      position: "absolute",
      right: -3,
      top: 15,
      padding: [0, 2],
      radius: 3,
      background: [0, 0, 0, 0.65],
      font_size: 10,
      color: "#ffffff",
    },
    seq_fuel: { width: 26, min_width: 26, height: 3, grow: 0 },
    stage_row: {
      padding: [4, 6],
      radius: 4,
      border: 1,
      border_color: [0, 0, 0, 0],
      active_background: [0.37, 0.83, 0.54, 0.12],
      active_border_color: [0.37, 0.83, 0.54, 0.5],
    },

    // --- named classes ---
    title: { color: "#ffffff", font_size: 17 },
    section: { color: "#7fb8e0", font_size: 11, margin: [8, 0, 2, 0] },
    dim: { color: [1, 1, 1, 0.55], font_size: 12 },
    // Key of a key/value row: it takes the free width, so values line up on the right.
    key: { color: [1, 1, 1, 0.55], min_width: 112, grow: 1 },
    narrow: { min_width: 104, shrink: 0 },
    nowrap: { shrink: 0 },
    warning: { color: "#ffcc44" },
    // A screen message: readable over whatever is behind it.
    notice: { padding: [3, 10], background: [0.035, 0.05, 0.065, 0.75], radius: 4 },
    error: { color: "#ff6b6b" },
    marker: { color: "#5fd38a", min_width: 10 },
  },
}
