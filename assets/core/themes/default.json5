// Default theme. Every node gets the class named after its widget, then the classes in its
// `class` string, then its inline `style`; text also gets the `text` class underneath.
// Mods restyle the game by patching these classes or adding another theme record (all
// themes are merged in load order).
// Colours: "#rgb", "#rrggbb", "#rrggbbaa" or [r, g, b(, a)] in 0..1.
// `active_*` colours apply while a node's `active` condition holds (selected modes, open
// windows, the current stage).
//
// One look throughout: navy glass panels (a top-to-bottom gradient, a border lit along
// the top edge, a soft shadow), Barlow type with capitals for titles, cool white values
// over dimmer keys, hairlines between rows, and one teal accent (#38e0c4) for what is on
// or selected. Amber is thrust and warnings, blue the atmosphere. Screen edges and gaps
// between modules are 12 and 8 px. Icons are white SVGs tinted by `color`.
//
// UI colours blend in linear light, where a faint white overlay comes out far brighter
// than its alpha suggests; controls on panels therefore use solid surface colours:
// #1a2a3a (control), #23374a (hovered), #0e3a35 with a teal border (selected), #3b2c13
// (armed, amber).
{
  id: "default",
  fonts: ["fonts/Barlow-Medium.ttf", "fonts/Barlow-SemiBold.ttf"],
  // Named colours: a style says "$accent" wherever a colour goes, and a mod recolours everything
  // that uses one by patching `colors.accent`.
  colors: {
    accent: "#38e0c4",
    text: "#e4edf4",
    text_strong: "#ffffff",
    text_dim: "#8fa3b4",
    control: "#1a2a3a",
    control_hover: "#23374a",
    selected: "#0e3a35",
    primary: "#1d6f62",
    primary_hover: "#26897a",
    danger: "#ff9a9a",
    danger_hover: "#4a2428",
    // The menu's left panel and its edge; the groove a choice sits in; a line between groups. The
    // panel looks about 10% see-through: blending is in linear light, where a dark colour lets far
    // more through than its alpha says, so it takes 97% opaque to look 90%.
    rail: "#101c29f8",
    rail_edge: "#2a3b4d",
    track: "#0a131c",
    hairline: [1, 1, 1, 0.07],
    clear: [0, 0, 0, 0],
  },
  classes: {
    // --- widget defaults ---
    text: { font: "Barlow", font_weight: 500 },
    column: { gap: 2 },
    row: { gap: 8, align_items: "center" },
    spacer: { grow: 1 },
    label: { color: "$text", font_size: 13 },
    button: {
      padding: [3, 9],
      background: "$control",
      hover_background: "$control_hover",
      active_background: "$selected",
      border: 1,
      border_color: "#24364a",
      active_border_color: [0.22, 0.88, 0.77, 0.7],
      active_color: "$text_strong",
      radius: 4,
      color: "$text",
      font_size: 12,
      font_weight: 600,
      align_items: "center",
      justify_content: "center",
    },
    bar: { height: 5, min_width: 60, grow: 1, background: "#223244", radius: 3, clip: true },
    bar_fill: { background: "$accent" },
    image: { color: "$text" },
    panel: {
      padding: [7, 10],
      gap: 2,
      gradient: ["#16263aeb", "#0b1520e6"],
      radius: 8,
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.45], y: 4, blur: 16 },
    },
    window: {
      position: "absolute",
      min_width: 180,
      gradient: ["#16263aed", "#0b1520e8"],
      radius: 8,
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.45], y: 4, blur: 16 },
    },
    window_title: {
      direction: "row",
      gap: 7,
      padding: [5, 5, 5, 10],
      align_items: "center",
      background: [1, 1, 1, 0.012],
      border: [0, 0, 1, 0],
      border_color: [1, 1, 1, 0.06],
      radius: 0,
    },
    window_icon: { width: 14, height: 14, color: "$accent" },
    window_title_text: { color: "#dce8f2", font_size: 12, font_weight: 600, letter_spacing: 1.3, uppercase: true },
    window_content: { padding: [6, 10, 8, 10], gap: 0 },
    window_close: {
      width: 20,
      height: 20,
      padding: 0,
      border: 0,
      background: [0, 0, 0, 0],
      hover_background: [1, 0.42, 0.42, 0.22],
      radius: 4,
    },
    window_close_icon: { width: 10, height: 10, color: [1, 1, 1, 0.5] },
    // A popup's pin (part windows): lit teal while pinned.
    window_pin: {
      width: 20,
      height: 20,
      padding: 0,
      border: 1,
      border_color: [0, 0, 0, 0],
      background: [0, 0, 0, 0],
      hover_background: "$control_hover",
      active_background: "$selected",
      active_border_color: [0.22, 0.88, 0.77, 0.7],
      radius: 4,
    },
    window_pin_icon: { width: 12, height: 12, color: [1, 1, 1, 0.5], active_color: "$accent" },

    // --- menu screens and controls (see crates/osp_ui/src/components.rs) ---
    // One surface, the rail, and nothing inside it has a box at rest; four type sizes (28, 20, 15,
    // 12); and these controls only: `back`, `menu_row`, `btn`, `choice_item`, `tab`, `slider`. Text starts 48
    // px from the window's edge: a row's own padding takes it there, so its highlight can reach
    // past the text without being clipped by the scrolling body. A test holds menus to this.
    menu_shade: {
      position: "absolute",
      left: 0,
      top: 0,
      width: "100%",
      height: "100%",
      align_items: "start",
      background: [0.01, 0.02, 0.03, 0.2],
      z_index: 50,
    },
    menu_rail: {
      width: 560,
      height: "100%",
      padding: [48, 28, 32, 36],
      background: "$rail",
      border: [0, 1, 0, 0],
      border_color: "$rail_edge",
    },
    menu_body: { margin: [24, 0, 0, 0], padding: [0, 8, 0, 0], gap: 0, grow: 1, shrink: 1, min_height: 0, scroll: true },
    menu_display: { margin: [0, 12], font_size: 28, font_weight: 600, letter_spacing: 2.5, uppercase: true, color: "$text_strong" },
    menu_heading: { margin: [0, 12], font_size: 20, font_weight: 600, color: "$text_strong" },
    menu_subtitle: { margin: [4, 12, 0, 12], font_size: 12, color: "$text_dim" },
    menu_section: { margin: [16, 12, 4, 12], font_size: 12, font_weight: 600, letter_spacing: 1.2, uppercase: true, color: "$text_dim" },
    menu_text: { margin: [0, 12], font_size: 15, color: "$text" },
    menu_divider: { height: 1, margin: [8, 12], background: "$hairline" },
    menu_notice: { margin: [16, 12, 0, 12], font_size: 15, color: "$text" },
    menu_warning: { font_size: 12, color: "#ffc24a" },
    menu_tabs: { gap: 0, margin: [0, 12, 8, 12] },
    // One question over everything (`layouts/dialog.json5`). The shade takes the pointer, so nothing
    // behind it can be clicked until the question is answered.
    dialog_shade: {
      position: "absolute",
      left: 0,
      top: 0,
      width: "100%",
      height: "100%",
      align_items: "center",
      justify_content: "center",
      background: [0.01, 0.02, 0.03, 0.55],
      z_index: 900,
    },
    dialog_box: {
      width: 520,
      padding: [24, 12, 16, 12],
      gap: 12,
      background: "$rail",
      border: 1,
      border_color: "$rail_edge",
      radius: 4,
    },
    dialog_answers: { margin: [8, 12, 0, 12], gap: 8, justify_content: "end" },
    back: {
      align_self: "start",
      margin: [0, 0, 16, 2],
      padding: [6, 10],
      background: "$clear",
      hover_background: "$control_hover",
      border: 0,
      radius: 4,
      font_size: 15,
      font_weight: 600,
      color: "$text_strong",
    },
    menu_row: {
      direction: "column",
      align_items: "stretch",
      justify_content: "center",
      gap: 2,
      min_height: 44,
      padding: [6, 12],
      background: "$clear",
      hover_background: "$control_hover",
      active_background: "$selected",
      border: 0,
      radius: 4,
    },
    // A row that marks what is current (the vessel being flown) and does nothing when clicked: it
    // looks selected, under the pointer too.
    menu_row_current: { background: "$selected", hover_background: "$selected" },
    menu_row_head: { gap: 8 },
    // A row with a button of its own beside it, the button's edge in line with the rows' text.
    menu_row_action: { gap: 8, margin: [0, 12, 0, 0] },
    // What belongs to the row above it, like a save's quicksaves: stepped in under its text.
    menu_nested: { margin: [0, 0, 4, 24] },
    menu_row_text: { font_size: 15, color: "$text" },
    menu_row_meta: { font_size: 12, color: "$text_dim" },
    // A value that is what the row is for, like a key on the Controls tab.
    menu_row_value: { font_size: 15, font_weight: 600, color: "$text_strong" },
    menu_row_detail: { font_size: 12, color: "$text_dim" },
    btn: {
      height: 36,
      padding: [0, 16],
      background: "$control",
      hover_background: "$control_hover",
      border: 0,
      radius: 4,
      font_size: 15,
      font_weight: 600,
      color: "$text",
    },
    btn_primary: { background: "$primary", hover_background: "$primary_hover", color: "$text_strong" },
    btn_danger: { color: "$danger", hover_background: "$danger_hover" },
    btn_off: { color: "$text_dim", hover_background: "$control" },
    btn_wide: { margin: [0, 12] },
    // As wide as each other, so choices line up down a page and their segments stay even.
    choice: { width: 300, shrink: 0, gap: 2, padding: 2, radius: 6, background: "$track" },
    choice_item: {
      width: 0,
      grow: 1,
      height: 28,
      padding: [0, 4],
      background: "$clear",
      hover_background: "$control_hover",
      active_background: "$selected",
      border: 0,
      radius: 4,
      font_size: 15,
      font_weight: 500,
      color: "$text_dim",
      active_color: "$text_strong",
    },
    tab: {
      margin: [0, 16, 0, 0],
      padding: [8, 2],
      background: "$clear",
      hover_background: "$clear",
      active_background: "$clear",
      border: [0, 0, 2, 0],
      border_color: "$clear",
      active_border_color: "$accent",
      radius: 0,
      font_size: 15,
      font_weight: 600,
      color: "$text_dim",
      active_color: "$text_strong",
    },
    setting_row: { min_height: 40, padding: [0, 12], gap: 12 },
    setting_label: { min_width: 120, grow: 1, font_size: 15, color: "$text" },
    // A percentage dragged along a groove, as wide as a choice with its value beside it. The node
    // takes the pointer; the thumb hangs half over each end.
    slider_row: { width: 300, shrink: 0, gap: 14 },
    slider: { grow: 1, height: 32, direction: "column", justify_content: "center" },
    slider_track: { height: 6, radius: 3, background: "$track", clip: true },
    slider_fill: { radius: 3, background: "$accent" },
    slider_thumb: { position: "absolute", top: 7, width: 18, height: 18, margin: [0, 0, 0, -9], radius: 9, background: "$text_strong" },
    slider_value: { min_width: 44, font_size: 15, font_weight: 600, color: "$text_strong" },

    // --- the editor (see layouts/editor.json5) ---
    // Made of the menu's parts: the list on a narrower rail, the launch on a panel like it on the
    // other side, and the hangar between them, which takes the pointer.
    editor_root: { position: "absolute", left: 0, top: 0, width: "100%", height: "100%", direction: "row", z_index: 40 },
    editor_rail: { width: 340, padding: [97, 16, 32, 36] },
    // Always there, over the rail while that is out and on the hangar when it is not.
    editor_bar: { position: "absolute", left: 36, top: 45, gap: 8 },
    editor_back: { align_self: "center", margin: [0, 0, 0, 2] },
    // The bar's buttons are icons, each with a tooltip that names it and its key: Vessels and
    // Parts, then the tools (Shape, Move, Turn) in a groove, lit teal when on.
    editor_icon_btn: { width: 40, padding: 0, align_items: "center", justify_content: "center", active_background: "$selected" },
    editor_icon_choice: { width: "auto", align_self: "center", margin: [0, 0, 0, 8] },
    editor_icon_item: { width: 40, grow: 0, height: 32, padding: 0, align_items: "center", justify_content: "center" },
    editor_bar_icon: { width: 20, height: 20, color: "$text_dim", active_color: "$accent" },
    // The symmetry (radial with its count, or mirror) and the turn step, at the foot of the
    // hangar in its corner by the panel: the craft stands in the middle, and the staging takes
    // the other corner.
    editor_modes: {
      position: "absolute",
      bottom: 20,
      right: 316,
      padding: 6,
      gap: 8,
      align_items: "center",
      justify_content: "center",
      radius: 8,
      background: "$rail",
      border: 1,
      border_color: "$rail_edge",
    },
    editor_mode_item: { width: "auto", direction: "row", gap: 6, padding: [0, 10] },
    editor_mode_text: { font_size: 15, font_weight: 600, color: "$text_dim", active_color: "$text_strong" },
    // Beside the rail, or at the window's edge with the rail away.
    editor_staging: { align_self: "end", margin: [0, 0, 12, 12] },
    editor_panel: {
      position: "absolute",
      right: 0,
      top: 0,
      width: 300,
      height: "100%",
      padding: [48, 12, 32, 12],
      background: "$rail",
      border: [0, 0, 0, 1],
      border_color: "$rail_edge",
    },
    editor_stat: { min_height: 32 },
    // The picked part's settings in the rail, made of the menu's pieces on a narrower row: a back
    // to the parts over the part's name, sections, and a setting a row, its label keeping its width
    // and what sets it taking the rest. A choice drops its options down under it.
    editor_part_back: { align_self: "start" },
    editor_part_body: { margin: [12, 0, 0, 0] },
    editor_part_section: { margin: [14, 0, 2, 0] },
    editor_setting: { min_height: 34, padding: 0, gap: 6, align_items: "center" },
    editor_setting_label: { min_width: 0, width: 96, grow: 0, shrink: 0, font_size: 12, color: "$text_dim" },
    editor_step: { height: 26, min_width: 26, padding: [0, 6] },
    editor_part_wide: { grow: 1, shrink: 1, min_width: 0, height: 28, padding: [0, 8], font_size: 12 },
    editor_part_text: { grow: 1, shrink: 1, min_width: 0 },
    editor_options: { gap: 2, margin: [2, 0, 6, 102] },
    editor_option: { height: 26, padding: [0, 8], font_size: 12, background: "$clear", hover_background: "$control_hover", active_background: "$selected", active_color: "$accent" },
    editor_part_problem: { margin: [8, 0, 0, 0] },
    editor_part_remove: { margin: [12, 0, 0, 0] },
    editor_occupied: { margin: [12, 12, 0, 12], gap: 8 },
    editor_clear: { align_self: "stretch" },
    editor_notice: { margin: [0, 12, 8, 12] },
    editor_hint: { margin: [0, 12, 12, 12] },
    choice_wide: { width: "auto", margin: [4, 12] },
    // The parts list (osp_editor::parts_list): a search behind its icon; tabs that are icons, lit
    // teal; the filters, each a groove of chips behind an icon that wraps; a grid of tiles, three
    // across, each a picture of its part over its name, that scrolls; and under it what the
    // pointer is on.
    editor_parts: { padding: [97, 16, 24, 36] },
    editor_search_row: { gap: 8, margin: [0, 0, 8, 0] },
    editor_search_icon: { width: 18, height: 18, shrink: 0, color: "$text_dim" },
    editor_search: { grow: 1, shrink: 1, min_width: 0, height: 30 },
    editor_tabs: { gap: 2, margin: [0, 0, 8, 0] },
    editor_tab: { width: 44, height: 40, margin: 0, padding: 0 },
    editor_tab_icon: { width: 22, height: 22, color: "$text_dim", active_color: "$accent" },
    editor_filter: { gap: 8, margin: [0, 0, 6, 0], align_items: "start" },
    editor_filter_icon: { width: 16, height: 16, shrink: 0, margin: [6, 0, 0, 0], color: "$text_dim" },
    editor_chips: { width: "auto", grow: 1, shrink: 1, min_width: 0, wrap: true },
    editor_chip: { width: "auto", grow: 0, height: 24, padding: [0, 5], font_size: 12 },
    editor_parts_body: { margin: [4, 0, 0, 0] },
    editor_grid: { gap: 6, wrap: true, align_items: "start" },
    editor_tile: {
      width: 88,
      // Two lines of a name under the picture; a longer one is cut there.
      height: 118,
      padding: 4,
      direction: "column",
      justify_content: "start",
      gap: 2,
      background: "#15222f",
      active_background: "$selected",
      border: 1,
      border_color: [0, 0, 0, 0],
      active_border_color: "$accent",
      clip: true,
    },
    editor_tile_picture: { width: 80, height: 80, shrink: 0 },
    editor_tile_name: { font_size: 12, color: "$text", text_align: "center", break_words: true },
    editor_parts_more: { margin: [10, 0, 0, 0] },
    editor_card: { min_height: 92, margin: [8, 0, 0, 0], padding: [10, 0, 0, 0], gap: 3, border: [1, 0, 0, 0], border_color: "$hairline" },
    editor_card_name: { font_size: 15, font_weight: 600, color: "$text_strong" },
    editor_card_detail: { font_size: 12, color: "$text" },
    editor_card_about: { font_size: 12, color: "$text_dim" },

    // --- docks (see layouts/docks.json5) ---
    // Every `dock` node stacks what is docked into it; `dock_root` places a dock column on
    // the screen.
    dock: { gap: 8 },
    dock_root: { position: "absolute" },
    // Takes the dock's free height and scrolls when its windows do not fit.
    dock_scroll: { grow: 1, shrink: 1, min_height: 0, scroll: true },

    // --- flight modules ---
    // Panels anchored to the screen edges; centred ones set `left: "50%"` and a negative
    // left margin of half their width.
    module: { position: "absolute" },
    launcher: {
      position: "absolute",
      right: 12,
      top: 12,
      direction: "column",
      gap: 3,
      padding: 4,
      width: 44,
      gradient: ["#16263aeb", "#0b1520e6"],
      radius: 8,
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.45], y: 4, blur: 16 },
    },
    launcher_button: {
      width: 34,
      height: 34,
      padding: 0,
      radius: 6,
      background: [0, 0, 0, 0],
      border_color: [0, 0, 0, 0],
      hover_background: "#1f3142",
    },
    launcher_icon: { width: 19, height: 19, color: "#c9d6e1", active_color: "$accent" },
    launcher_divider: { height: 1, margin: [4, 6], background: [1, 1, 1, 0.1] },
    // Shown beside a node with a `tooltip` while the pointer is over it.
    tooltip: {
      padding: [4, 9],
      background: "#0d1824f5",
      radius: 5,
      border: 1,
      border_color: [0.65, 0.82, 0.94, 0.25],
      shadow: { color: [0, 0, 0, 0.5], y: 3, blur: 10 },
      color: "$text",
      font_size: 12,
    },
    readout: { color: "$text_strong", font_size: 26, font_weight: 600 },
    alt_readout: { color: "$text_strong", font_size: 24, font_weight: 600, letter_spacing: 0.5 },
    caption: { color: "#7f94a6", font_size: 10.5, font_weight: 600, letter_spacing: 1, uppercase: true },
    // A pill: fully rounded ends.
    pill: {
      padding: [4, 12],
      radius: 99,
      gradient: ["#16263aeb", "#0b1520e6"],
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.45], y: 4, blur: 16 },
    },
    // A coloured status dot (altimeter: the situation).
    status_dot: { width: 7, height: 7, radius: 4, background: "$accent" },

    // --- time warp (layouts/time.json5) ---
    time_button: {
      width: 26,
      height: 26,
      padding: 0,
      radius: 99,
      border: 0,
      background: [0, 0, 0, 0],
      hover_background: "$control_hover",
      active_background: "$selected",
    },
    time_icon: { width: 13, height: 13, color: "#c9d6e1", active_color: "$accent" },
    // One chevron per warp level, lit up to the current one; on-rails levels in amber.
    warp_chevron: { width: 6, height: 13, color: "#2a3b4d", active_color: "$accent" },
    warp_rails: { active_color: "#ffb340" },
    warp_rate: { min_width: 50, font_size: 15, font_weight: 600, color: "$text_strong" },
    divider: { width: 1, height: 26, background: [1, 1, 1, 0.1] },
    // The next alarm, under the clocks and lined up with them; a click opens the Alarm clock.
    alarm_row: {
      direction: "row",
      justify_content: "start",
      align_items: "center",
      padding: [0, 4, 0, 0],
      background: [0, 0, 0, 0],
      hover_background: "$control_hover",
      border: 0,
      radius: 3,
    },
    alarm_icon: { width: 13, height: 13, margin: [0, 19, 0, 0], color: "#7f94a6" },

    // --- navball (layouts/navball.json5) ---
    // The housing is one picture (icons/navball_housing.svg); the ball, gauges and
    // readouts sit on it at fixed places.
    housing: { position: "absolute", left: 0, top: 0, width: 272, height: 252 },
    navball_ball: { position: "absolute", left: 58, top: 44, width: 156, height: 156 },
    // Arc gauges round the ball: a ring's `border` is its thickness, `border_color` the
    // empty track, `color` the fill.
    gauge_thrust: { position: "absolute", left: 33, top: 19, width: 206, height: 206, border: 8, border_color: [1, 1, 1, 0.07], color: "#ffb340" },
    gauge_throttle: { position: "absolute", left: 42, top: 28, width: 188, height: 188, border: 2, border_color: [1, 1, 1, 0.05], color: "$accent" },
    gauge_atmosphere: { position: "absolute", left: 33, top: 19, width: 206, height: 206, border: 8, border_color: [1, 1, 1, 0.07], color: "#5ab4ff" },
    speed_display: {
      position: "absolute",
      left: 80,
      top: 1,
      width: 112,
      height: 35,
      padding: 0,
      gap: 0,
      direction: "column",
      background: [0, 0, 0, 0],
      hover_background: "#ffffff06",
      border: 0,
      radius: 11,
    },
    speed_frame: { color: "$accent", font_size: 10, font_weight: 600, letter_spacing: 1.2, uppercase: true },
    speed_value: { color: "$text_strong", font_size: 15, font_weight: 600 },
    // SAS and RCS switches on the ring's upper corners, teal while on.
    nav_toggle: {
      position: "absolute",
      top: 45,
      width: 40,
      height: 18,
      padding: 0,
      radius: 99,
      background: "#0b141e",
      hover_background: "$control",
      active_background: "#12392f",
      border: 1,
      border_color: [1, 1, 1, 0.14],
      active_border_color: "$accent",
      color: [1, 1, 1, 0.55],
      active_color: "$accent",
      font_size: 10,
      font_weight: 600,
    },
    nav_toggle_text: { letter_spacing: 1 },
    // Heading plate cells.
    plate: { position: "absolute", left: 36, top: 220, width: 200, height: 31, direction: "row", gap: 0, align_items: "center" },
    plate_cell: { width: "33.3%", direction: "row", gap: 4, justify_content: "center", align_items: "baseline" },
    plate_key: { color: "#7f94a6", font_size: 9.5, font_weight: 600, letter_spacing: 0.8 },
    plate_value: { color: "$text_strong", font_size: 13, font_weight: 600 },
    // The SAS mode buttons right against the housing's ring, with the navball's own markers on
    // them. Four rows level with the ball; the target's row comes in below them.
    sas_strip: {
      position: "absolute",
      left: 254,
      top: 62,
      gap: 3,
      align_items: "center",
    },
    sas_button: {
      width: 28,
      height: 28,
      padding: 0,
      radius: 6,
      background: "#172634",
      border_color: [0, 0, 0, 0],
      hover_background: "$control_hover",
      active_background: "$selected",
    },
    sas_icon: { width: 20, height: 20, color: "$text_strong" },
    // A mode with nothing to steer by: dimmed, and nothing happens under the pointer.
    sas_button_off: { background: "#111c27", hover_background: "#111c27" },
    sas_icon_off: { color: [1, 1, 1, 0.25] },
    // Small +/- and step buttons (flight plan).
    step_button: { min_width: 26, padding: [1, 6], font_size: 12 },
    // A text box: a well in the panel, teal-edged while typed into, with what it showed in teal
    // until the first key replaces it.
    input: {
      padding: [2, 6],
      background: "$track",
      hover_background: "$control",
      active_background: "$track",
      border: 1,
      border_color: "#24364a",
      active_border_color: "$accent",
      active_color: "$accent",
      radius: 3,
      color: "$text",
      font_size: 13,
      align_items: "center",
    },
    // A box in the Flight plan window, as wide as the value it replaced.
    value_input: { min_width: 86 },
    // Buttons that take something out of the game, and recovery (Universe Manifest).
    danger_button: { color: "$danger", hover_background: "$danger_hover" },
    recover_button: { color: "#6ff0d6", hover_background: "$selected" },
    // A manifest row's name; debris is dimmer.
    manifest_name: { min_width: 180, active_color: [1, 1, 1, 0.55] },
    value: { min_width: 86, font_size: 13 },
    vbar: { width: 8, min_width: 8, height: 170, grow: 0 },
    thin: { width: 3, min_width: 3 },
    ibar: { min_width: 46, height: 3 },
    // The Resources window (layouts/resources.json5): a row per propellant and stage, bars in
    // the stage's colour, the bottom stage's names lit.
    res_row: { gap: 7, padding: [2, 3], radius: 4, hover_background: "#ffffff06" },
    res_name: { min_width: 70, shrink: 0, color: "$text_dim", active_color: "$text_strong", font_size: 12.5 },
    res_amount: { min_width: 72, shrink: 0, font_size: 12.5 },
    res_bar: { min_width: 30 },
    res_tag: { min_width: 22, shrink: 0 },
    // The sequence stack (layouts/staging.json5): tiles of 24 px, four to a line.
    // No panel round the stack: every row is a box of its own, as wide as it needs.
    seq_stack: { align_self: "start", align_items: "start", gap: 0 },
    seq_key: { color: "#7f94a6", font_size: 10, font_weight: 600, letter_spacing: 0.8, uppercase: true },
    seq_stat: { color: "$text", font_size: 12.5, font_weight: 600 },
    // Plain glyph buttons: no background until hovered.
    seq_glyph: {
      padding: [0, 4],
      background: "#00000000",
      hover_background: "#ffffff1a",
      border: 0,
      radius: 3,
      color: "$text_dim",
      font_size: 13,
      font_weight: 600,
    },
    // The arrows at the end of a row.
    seq_arrows: { gap: 0, justify_content: "center" },
    seq_arrow: {
      padding: [0, 1],
      background: "#00000000",
      hover_background: "#ffffff1a",
      border: 0,
      radius: 2,
    },
    seq_arrow_icon: { width: 10, height: 10, color: "$text_dim" },
    seq_glyph_icon: { width: 13, height: 13, color: "$text_dim" },
    // The strip between two rows, a drop place that lights up under a dragged row or tile. It
    // takes the row's width, which the stack it sits in would not give it.
    seq_gap: { align_self: "stretch", height: 5, radius: 2, background: "#00000000", hover_background: "$accent" },
    seq_row: {
      padding: [3, 4],
      gap: 5,
      min_height: 24,
      min_width: 44,
      radius: 4,
      border: 1,
      background: "#0f1c28ee",
      border_color: "#203142",
      hover_background: "#1f3b4a",
      active_background: "#0e3a35f2",
      active_border_color: "$accent",
    },
    seq_number: { min_width: 10, font_size: 12, font_weight: 600, color: [1, 1, 1, 0.45], active_color: "$accent" },
    seq_tiles: { align_items: "start", gap: 4 },
    seq_line: { gap: 4 },
    seq_item: {
      width: 24,
      height: 24,
      align_items: "center",
      justify_content: "center",
      radius: 4,
      background: "#ffffff0f",
      hover_background: "#ffffff24",
    },
    seq_icon: { width: 16, height: 16, color: "#dfe8ef" },
    seq_count: {
      position: "absolute",
      right: -4,
      top: -5,
      padding: [0, 3],
      radius: 3,
      background: "#0b141ee6",
      border: 1,
      border_color: [1, 1, 1, 0.15],
      font_size: 9.5,
      font_weight: 600,
      color: "$text_strong",
    },
    seq_fuel: { position: "absolute", left: 4, bottom: 2, width: 16, min_width: 16, height: 2, grow: 0 },
    // Under the stack: the engines already lit.
    seq_armed: { background: "#3b2c13d9", border_color: "#b07a2a", margin: [3, 0, 0, 0] },
    seq_add: { align_self: "start", margin: [0, 0, 1, 0] },
    seq_stats: { align_items: "stretch", gap: 3, padding: [3, 5, 5, 5], margin: [5, 0, 0, 0], hover_background: "#0f1c28ee" },
    // Its tabs, and the pages under them: as tall as each other, so the stack stays put.
    seq_tabs: { gap: 2 },
    seq_tab: {
      grow: 1,
      padding: [1, 6],
      radius: 3,
      border: 0,
      background: "#00000000",
      hover_background: "#1f3142",
      active_background: "$selected",
      color: "#7f94a6",
      active_color: "$accent",
      font_size: 10,
      font_weight: 600,
      letter_spacing: 0.6,
      uppercase: true,
    },
    seq_page: { gap: 2, min_height: 40, padding: [0, 2], justify_content: "center" },
    seq_input: { gap: 5, align_items: "center" },
    stage_row: {
      padding: [4, 6],
      radius: 5,
      border: 1,
      border_color: [0, 0, 0, 0],
      active_background: "#0e3a35d9",
      active_border_color: "$accent",
    },
    // The part window (layouts/part_info.json5): an engine's status in amber while it burns,
    // short bars beside the values, the catalogue text at the bottom.
    part_status: { active_color: "#ffb340" },
    part_bar: { min_width: 40, max_width: 70 },
    part_description: { margin: [6, 0, 0, 0], font_size: 11.5 },

    // --- map view (layouts/map_menu.json5, layouts/node_panel.json5) ---
    // The context menu: a plain list on a glass panel, items lit under the pointer.
    context_menu: {
      position: "absolute",
      min_width: 170,
      padding: 4,
      gap: 0,
      gradient: ["#16263af2", "#0b1520ee"],
      radius: 7,
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.5], y: 4, blur: 16 },
    },
    context_title: { color: "$text_dim", font_size: 11, font_weight: 600, letter_spacing: 0.5, padding: [3, 8, 5, 8] },
    context_item: {
      justify_content: "start",
      padding: [5, 8],
      background: [0, 0, 0, 0],
      border_color: [0, 0, 0, 0],
      hover_background: "$control_hover",
      radius: 4,
      font_size: 12.5,
      font_weight: 500,
    },
    // The selected manoeuvre's panel, beside the navball and under the windows.
    node_panel: {
      position: "absolute",
      width: 264,
      padding: [8, 11, 9, 11],
      gap: 2,
      z_index: -5,
      gradient: ["#16263aeb", "#0b1520e6"],
      radius: 8,
      border: 1,
      border_gradient: ["#a6d0f055", "#6f98c014"],
      shadow: { color: [0, 0, 0, 0.45], y: 4, blur: 16 },
    },
    node_time: { color: "#cfdbe5", font_size: 12.5 },
    node_dv: { color: "$text_strong", font_size: 22, font_weight: 600 },
    node_axes: { gap: 12, margin: [0, 0, 4, 0] },
    node_axis: { gap: 3 },
    node_axis_icon: { width: 15, height: 15, color: "$text_strong" },
    node_axis_input: { min_width: 56, padding: [1, 5] },
    node_actions: { gap: 4, margin: [6, 0, 0, 0] },

    // --- named classes ---
    title: { color: "$text_strong", font_size: 17, font_weight: 600 },
    section: { color: "$accent", font_size: 10.5, font_weight: 600, letter_spacing: 1.2, uppercase: true, margin: [8, 0, 2, 0] },
    dim: { color: "$text_dim", font_size: 12.5 },
    // A key/value row in a window: a hairline under each.
    kv: { padding: [2, 0], border: [0, 0, 1, 0], border_color: [1, 1, 1, 0.05] },
    // A row's leading icon.
    row_icon: { width: 14, height: 14, color: "#6f8496" },
    // Key of a key/value row: it takes the free width, so values line up on the right.
    key: { color: "$text_dim", min_width: 64, grow: 1 },
    narrow: { min_width: 104, shrink: 0 },
    nowrap: { shrink: 0 },
    warning: { color: "#ffc24a" },
    // A screen message: readable over whatever is behind it.
    notice: {
      padding: [5, 14],
      background: "#0b141ed9",
      radius: 99,
      border: 1,
      border_color: [1, 0.76, 0.29, 0.35],
      shadow: { color: [0, 0, 0, 0.4], y: 3, blur: 12 },
    },
    error: { color: "#ff6b6b" },
    marker: { color: "$accent", min_width: 10 },
    // The mission's goals: a ring, filled with a tick once met, and the text lit teal.
    goal_mark: { width: 14, height: 14, color: "#6f8496", active_color: "$accent" },
    goal_text: { color: "$text", active_color: "$accent", grow: 1 },
    // The tutorial's step and its hint.
    // Wrapped to the window (290 wide), or a long step would stretch the dock.
    tutorial_text: { color: "$text_strong", font_size: 14, max_width: 264 },
    tutorial_hint: { color: "#ffc24a", font_size: 12.5, max_width: 264 },
    alert_chip: {
      color: "#ffe2dc",
      background: "#5a1c14e8",
      border: 1,
      border_color: "#ff6a55",
      radius: 4,
      padding: [2, 8],
      font_size: 12.5,
      font_weight: 600,
    },
    goal_notice: { color: "$accent", border_color: [0.22, 0.88, 0.77, 0.5] },
  },
}
