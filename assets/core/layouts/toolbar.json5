// The app launcher (top right): toggles the flight modules, KSP style. Each button lights
// up while its window is open (`ui.shown.<layout>`). Mods add their own windows here with
// an `insert` patch on `#toolbar.children`.
{
  id: "toolbar",
  group: "flight",
  root: {
    id: "toolbar",
    widget: "row",
    class: "launcher",
    children: [
      { widget: "button", class: "launcher_button", text: "Flight", action: "ui.toggle:flight_info", active: "ui.shown.flight_info" },
      { widget: "button", class: "launcher_button", text: "Orbit", action: "ui.toggle:orbit_info", active: "ui.shown.orbit_info" },
      { widget: "button", class: "launcher_button", text: "Plan", action: "ui.toggle:flight_plan", active: "ui.shown.flight_plan" },
      { widget: "button", class: "launcher_button", text: "Target", action: "ui.toggle:target_info", active: "ui.shown.target_info" },
      { widget: "button", class: "launcher_button", text: "Transfer", action: "ui.toggle:transfer_planner", active: "ui.shown.transfer_planner" },
      { widget: "button", class: "launcher_button", text: "Vessel", action: "ui.toggle:vessel_info", active: "ui.shown.vessel_info" },
      { widget: "button", class: "launcher_button", text: "Attitude", action: "ui.toggle:attitude_info", active: "ui.shown.attitude_info" },
      { widget: "button", class: "launcher_button", text: "Structure", action: "ui.toggle:structure_info", active: "ui.shown.structure_info" },
      { widget: "button", class: "launcher_button", text: "Log", action: "ui.toggle:log", active: "ui.shown.log" },
      { widget: "button", class: "launcher_button", text: "Map", action: "view.toggle_map", active: "view.map" },
      { widget: "button", class: "launcher_button", text: "Mods", action: "ui.toggle:mods", active: "ui.shown.mods" },
      { widget: "button", class: "launcher_button", text: "Help", action: "ui.toggle:help", active: "ui.shown.help" },
    ],
  },
}
