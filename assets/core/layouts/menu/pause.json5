// Esc with a game in progress. Going back from here resumes. The vessels come first, then the game.
// In a tutorial only what makes sense in one shows. Mods add rows to `#pause_items.children`. What
// leaves the game goes through `ask.leave`, which asks to save first if that would lose anything.
// Reverting shows after a launch in this game and asks first (`ask.revert`). Recover vessel shows
// while the one being flown is down on a world with a launch site (`menu.can_recover`) and asks first
// (`ask.recover`): it comes home and the space centre opens. Space centre (`centre.open`) goes there,
// to build and launch the next. A career's tech tree opens over the menu
// (`tree.open`).
{
  id: "menu_pause",
  group: "menu",
  visible: false,
  root: {
    id: "pause_items",
    widget: "screen",
    title: "Paused",
    subtitle: "{menu.game_line}",
    back: false,
    children: [
      { widget: "menu_row", text: "Resume", action: "game.resume" },
      { widget: "menu_row", text: "Restart tutorial", action: "game.start_tutorial:{tutorial.id}", visible: "tutorial.active" },
      { widget: "menu_divider" },
      { widget: "menu_row", text: "Vessels", meta: "{menu.vessel_line}", action: "menu.open:vessels", visible: "!tutorial.active" },
      { widget: "menu_row", text: "Space centre", meta: "Build and launch", action: "centre.open", visible: "!tutorial.active" },
      { widget: "menu_row", text: "Recover vessel", meta: "{menu.flown_name}", action: "ask.recover", visible: "menu.can_recover" },
      { widget: "menu_row", text: "Revert to launch", meta: "{menu.revert_line}", action: "ask.revert:launch", visible: "menu.can_revert" },
      { widget: "menu_row", text: "Revert to hangar", action: "ask.revert:hangar", visible: "menu.can_revert" },
      { widget: "menu_row", text: "Tech tree", meta: "{career.science} science", action: "tree.open", visible: "career.active" },
      { widget: "menu_divider", visible: "!tutorial.active" },
      { widget: "menu_row", text: "Save game", meta: "{menu.save_name}", action: "menu.open:save", visible: "!tutorial.active" },
      { widget: "menu_row", text: "Load game", action: "menu.open:load", visible: "!tutorial.active" },
      { widget: "menu_row", text: "New game", action: "menu.open:new_game", visible: "!tutorial.active" },
      { widget: "menu_divider", visible: "!tutorial.active" },
      { widget: "menu_row", text: "Settings", action: "menu.open:settings" },
      { widget: "menu_row", text: "Exit to main menu", action: "ask.leave:game.exit" },
      { widget: "menu_row", text: "Quit", action: "ask.leave:game.quit" },
    ],
  },
}
