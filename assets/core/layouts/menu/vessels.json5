// The vessels in the game in progress (`menu.vessels`, debris left out), to fly with `vessel.fly:<id>`
// or destroy with `ask.destroy:<id>`, which asks first. The one being flown is marked and does nothing
// when clicked. Destroying it flies another, and if it was the last goes to the empty hangar for a
// new one. One that is down on a world with a launch site (`item.can_recover`) can be brought home
// with `ask.recover:<id>`, which asks first; recovering the one being flown goes to the hangar.
{
  id: "menu_vessels",
  group: "menu",
  visible: false,
  root: {
    widget: "screen",
    title: "Vessels",
    repeat: "menu.vessels",
    children: [
      {
        widget: "row",
        class: "menu_row_action",
        children: [
          { widget: "menu_row", style: { grow: 1 }, text: "{item.name}", detail: "{item.where}", action: "vessel.fly:{item.id}", visible: "!item.flying" },
          { widget: "menu_row", class: "menu_row_current", style: { grow: 1 }, text: "{item.name}", meta: "{item.state}", detail: "{item.where}", visible: "item.flying" },
          { widget: "button", class: "btn", text: "Recover", action: "ask.recover:{item.id}", visible: "item.can_recover" },
          { widget: "button", class: "btn btn_danger", text: "Destroy", action: "ask.destroy:{item.id}" },
        ],
      },
    ],
  },
}
