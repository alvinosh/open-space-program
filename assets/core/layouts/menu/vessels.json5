// The vessels in the game in progress (`menu.vessels`, debris left out), to fly with `vessel.fly:<id>`
// or destroy with `ask.destroy:<id>`, which asks first. Destroying the one being flown flies another,
// and if it was the last goes to the empty hangar for a new one.
{
  id: "menu_vessels",
  group: "menu",
  visible: false,
  root: {
    widget: "screen",
    title: "Vessels",
    repeat: "menu.vessels",
    children: [
      {
        widget: "row",
        class: "menu_row_action",
        children: [
          { widget: "menu_row", style: { grow: 1 }, text: "{item.name}", meta: "{item.state}", detail: "{item.where}", active: "item.flying", action: "vessel.fly:{item.id}" },
          { widget: "button", class: "btn btn_danger", text: "Destroy", action: "ask.destroy:{item.id}" },
        ],
      },
    ],
  },
}
