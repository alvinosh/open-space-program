// The saves (`menu.saves`), newest first. Clicking one carries on from it, asking first to save a game
// in progress (`ask.leave`); deleting one asks (`ask.delete_save`).
{
  id: "menu_load",
  group: "menu",
  visible: false,
  root: {
    widget: "screen",
    title: "Load game",
    children: [
      { widget: "label", class: "menu_text", text: "No saved games yet: a game is saved from its first launch on.", visible: "!menu.has_saves" },
      {
        widget: "column",
        repeat: "menu.saves",
        children: [
          {
            widget: "row",
            class: "menu_row_action",
            children: [
              { widget: "menu_row", style: { grow: 1 }, text: "{item.name}", meta: "{item.saved}", detail: "{item.detail}", action: "ask.leave:game.load:{item.file}" },
              { widget: "button", class: "btn btn_danger", text: "Delete", action: "ask.delete_save:{item.file}" },
            ],
          },
        ],
      },
    ],
  },
}
