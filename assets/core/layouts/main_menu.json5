// Main menu: play, pick a scenario, go back to the flight in progress (`game.resume`), or quit.
// The game opens on it unless OSP_SCENARIO picks a scenario; Esc (`game.menu`) brings it
// back.
//
// The Play page (`menu.page:play`) goes by steps, in `menu.play`: nothing yet, then `load` (the
// saves in `menu.saves`: `game.load:<file>`, `game.delete_save:<file>` asks and then deletes),
// `vessels` (`game.new` starts here: `menu.vessels` to fly, `game.fly:<id>`, or a new one) and
// `craft` (`menu.craft`, each shown in the editor by `editor.open:<id>`, see editor.json5).
// `menu.play` goes back. `game.save` saves the game in progress, `game.save_as` to a new save.
//
// A scenario is picked in two steps: where it starts (`menu.place:<pad|runway|orbit>`, shown when `menu.count.<place>` scenarios start there; `menu.place` goes back),
// then the spacecraft (`game.start:<id>`), listed from `menu.scenarios` (id, craft, name,
// description, start) in load order.
//
// The Tutorials page (`menu.page:tutorials`) lists the `tutorials` records, started with
// `game.start_tutorial:<id>`.
//
// The Graphics page (`menu.page:graphics`) sets the graphics: a preset
// (`graphics.preset:<low|medium|high|ultra>`), the one recommended for the GPU
// (`graphics.detect`), or each setting (`graphics.set:<key>:<value>`, current values in
// `graphics.<key>`). The frame rate below it updates live over the scene behind the menu.
// The Sound page (`menu.page:sound`) sets how loud each part of the sound is
// (`audio.set:<key>:<percent>`, current values in `audio.<key>`). The Controls page
// (`menu.page:controls`) rebinds keys (`keys.listen:<id>`, `keys.reset`, the list in `keys.rows`).
// The Interface page (`menu.page:interface`) sets the rest (`interface.set:<key>:<value>`, current
// values in `interface.<key>`).
{
  id: "main_menu",
  visible: false,
  root: {
    widget: "column",
    class: "menu_backdrop",
    children: [
      {
        widget: "panel",
        class: "menu",
        children: [
          { widget: "label", class: "menu_title", text: "Open Space Program" },
          {
            widget: "row",
            style: { gap: 4 },
            children: [
              { widget: "button", class: "menu_tab", text: "Play", action: "menu.page:play", active: "menu.page == play" },
              { widget: "button", class: "menu_tab", text: "Scenarios", action: "menu.page:scenarios", active: "menu.page == scenarios" },
              { widget: "button", class: "menu_tab", text: "Tutorials", action: "menu.page:tutorials", active: "menu.page == tutorials", visible: "menu.tutorials" },
              { widget: "button", class: "menu_tab", text: "Graphics", action: "menu.page:graphics", active: "menu.page == graphics" },
              { widget: "button", class: "menu_tab", text: "Sound", action: "menu.page:sound", active: "menu.page == sound" },
              { widget: "button", class: "menu_tab", text: "Controls", action: "menu.page:controls", active: "menu.page == controls" },
              { widget: "button", class: "menu_tab", text: "Interface", action: "menu.page:interface", active: "menu.page == interface" },
            ],
          },
          {
            widget: "column",
            class: "menu_page",
            visible: "menu.page == play",
            children: [
              {
                widget: "column",
                class: "menu_page",
                visible: "!menu.play",
                children: [
                  { widget: "label", class: "dim", text: "Start a new game, or carry on with a saved one" },
                  {
                    widget: "column",
                    class: "menu_list",
                    children: [
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "game.new",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/play.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "New game" },
                              { widget: "label", class: "dim", text: "Nothing flying yet: pick a vessel and launch it." },
                            ],
                          },
                        ],
                      },
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "menu.play:load",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/log.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "Load game" },
                              { widget: "label", class: "dim", text: "Carry on from a save." },
                            ],
                          },
                        ],
                      },
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "menu.play:vessels",
                        visible: "menu.playing",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/flight.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "Vessels" },
                              { widget: "label", class: "dim", text: "Fly another vessel in this game, or launch a new one." },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
              {
                widget: "column",
                class: "menu_page",
                visible: "menu.play == load",
                children: [
                  {
                    widget: "row",
                    children: [
                      { widget: "button", class: "menu_option", text: "Back", action: "menu.play" },
                      { widget: "label", class: "title", text: "Load game" },
                    ],
                  },
                  { widget: "label", class: "dim", text: "No saved games yet: a game is saved from its first launch on.", visible: "!menu.has_saves" },
                  {
                    widget: "column",
                    class: "menu_list",
                    repeat: "menu.saves",
                    children: [
                      {
                        widget: "row",
                        style: { gap: 6 },
                        children: [
                          {
                            widget: "button",
                            class: "menu_item",
                            style: { grow: 1 },
                            action: "game.load:{item.file}",
                            children: [
                              {
                                widget: "row",
                                class: "menu_item_head",
                                children: [
                                  { widget: "label", class: "menu_item_name", text: "{item.name}" },
                                  { widget: "spacer" },
                                  { widget: "label", class: "menu_item_start", text: "{item.saved}" },
                                ],
                              },
                              { widget: "label", class: "menu_item_setup", text: "{item.flying}", visible: "item.flying" },
                              { widget: "label", class: "dim", text: "{item.time}, vessels in the game: {item.vessels|int}", visible: "!item.problem" },
                              { widget: "label", class: "warning", text: "{item.problem}", visible: "item.problem" },
                            ],
                          },
                          { widget: "button", class: "menu_option", text: "Delete", action: "game.delete_save:{item.file}", visible: "!item.deleting" },
                          { widget: "button", class: "menu_option", text: "Sure?", action: "game.delete_save:{item.file}", visible: "item.deleting", active: "item.deleting" },
                        ],
                      },
                    ],
                  },
                ],
              },
              {
                widget: "column",
                class: "menu_page",
                visible: "menu.play == vessels",
                children: [
                  {
                    widget: "row",
                    children: [
                      { widget: "button", class: "menu_option", text: "Back", action: "menu.play" },
                      { widget: "label", class: "title", text: "New game", visible: "menu.new_game" },
                      { widget: "label", class: "title", text: "Vessels", visible: "!menu.new_game" },
                      { widget: "spacer" },
                      { widget: "label", class: "dim", text: "Choose a vessel to fly, or a new one", visible: "menu.vessels" },
                      { widget: "label", class: "dim", text: "Nothing is flying yet", visible: "!menu.vessels" },
                    ],
                  },
                  {
                    widget: "button",
                    class: "menu_item menu_place",
                    style: { margin: [0, 12, 0, 0] },
                    action: "menu.play:craft",
                    children: [
                      { widget: "image", class: "menu_place_icon", image: "icons/launch_pad.svg" },
                      {
                        widget: "column",
                        class: "menu_place_text",
                        children: [
                          { widget: "label", class: "menu_item_name", text: "Fly a new vessel" },
                          { widget: "label", class: "dim", text: "Pick a craft, look it over in the editor, and launch it." },
                        ],
                      },
                    ],
                  },
                  {
                    widget: "column",
                    class: "menu_list",
                    repeat: "menu.vessels",
                    children: [
                      {
                        widget: "button",
                        class: "menu_item",
                        action: "game.fly:{item.id}",
                        children: [
                          {
                            widget: "row",
                            class: "menu_item_head",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "{item.name}" },
                              { widget: "spacer" },
                              { widget: "label", class: "menu_item_start", text: "Flying now", visible: "item.flying" },
                            ],
                          },
                          { widget: "label", class: "dim", text: "{item.where}" },
                        ],
                      },
                    ],
                  },
                ],
              },
              {
                widget: "column",
                class: "menu_page",
                visible: "menu.play == craft",
                children: [
                  {
                    widget: "row",
                    children: [
                      { widget: "button", class: "menu_option", text: "Back", action: "menu.play:vessels" },
                      { widget: "label", class: "title", text: "Fly a new vessel" },
                      { widget: "spacer" },
                      { widget: "label", class: "dim", text: "Choose a vessel" },
                    ],
                  },
                  {
                    widget: "column",
                    class: "menu_list",
                    repeat: "menu.craft",
                    children: [
                      {
                        widget: "button",
                        class: "menu_item",
                        action: "editor.open:{item.id}",
                        children: [
                          {
                            widget: "row",
                            class: "menu_item_head",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "{item.name}" },
                              { widget: "spacer" },
                              { widget: "label", class: "menu_item_start", text: "{item.parts|int} parts" },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          {
            widget: "column",
            class: "menu_page",
            visible: "menu.page == scenarios",
            children: [
              {
                widget: "column",
                class: "menu_page",
                visible: "!menu.place",
                children: [
                  { widget: "label", class: "dim", text: "Choose where to start" },
                  {
                    widget: "column",
                    class: "menu_list",
                    children: [
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "menu.place:pad",
                        visible: "menu.count.pad",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/launch_pad.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "Launch pad" },
                              { widget: "label", class: "dim", text: "On the pad, ready to lift off." },
                            ],
                          },
                          { widget: "label", class: "menu_count", text: "{menu.count.pad|int}" },
                        ],
                      },
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "menu.place:runway",
                        visible: "menu.count.runway",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/runway.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "Runway" },
                              { widget: "label", class: "dim", text: "Lined up at the end of a runway, on its wheels." },
                            ],
                          },
                          { widget: "label", class: "menu_count", text: "{menu.count.runway|int}" },
                        ],
                      },
                      {
                        widget: "button",
                        class: "menu_item menu_place",
                        action: "menu.place:orbit",
                        visible: "menu.count.orbit",
                        children: [
                          { widget: "image", class: "menu_place_icon", image: "icons/orbit.svg" },
                          {
                            widget: "column",
                            class: "menu_place_text",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "Orbit" },
                              { widget: "label", class: "dim", text: "Already in orbit." },
                            ],
                          },
                          { widget: "label", class: "menu_count", text: "{menu.count.orbit|int}" },
                        ],
                      },
                    ],
                  },
                ],
              },
              {
                widget: "column",
                class: "menu_page",
                visible: "menu.place",
                children: [
                  {
                    widget: "row",
                    children: [
                      { widget: "button", class: "menu_option", text: "Back", action: "menu.place" },
                      { widget: "label", class: "title", text: "Launch pad", visible: "menu.place == pad" },
                      { widget: "label", class: "title", text: "Runway", visible: "menu.place == runway" },
                      { widget: "label", class: "title", text: "Orbit", visible: "menu.place == orbit" },
                      { widget: "spacer" },
                      { widget: "label", class: "dim", text: "Choose a spacecraft" },
                    ],
                  },
                  {
                    widget: "column",
                    class: "menu_list",
                    repeat: "menu.scenarios",
                    children: [
                      {
                        widget: "button",
                        class: "menu_item",
                        action: "game.start:{item.id}",
                        children: [
                          {
                            widget: "row",
                            class: "menu_item_head",
                            children: [
                              { widget: "label", class: "menu_item_name", text: "{item.craft}" },
                              { widget: "spacer" },
                              { widget: "label", class: "menu_item_start", text: "{item.start}" },
                            ],
                          },
                          { widget: "label", class: "menu_item_setup", text: "{item.name}", visible: "item.name" },
                          { widget: "label", class: "dim", text: "{item.description}", visible: "item.description" },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          {
            // Guided runs: each starts its scenario with the steps over it (`game.start_tutorial`).
            widget: "column",
            class: "menu_page",
            visible: "menu.page == tutorials",
            children: [
              { widget: "label", class: "dim", text: "Learn by flying: each one tells you what to do and waits for you to do it" },
              {
                widget: "column",
                class: "menu_list",
                repeat: "menu.tutorials",
                children: [
                  {
                    widget: "button",
                    class: "menu_item",
                    action: "game.start_tutorial:{item.id}",
                    children: [
                      {
                        widget: "row",
                        class: "menu_item_head",
                        children: [
                          { widget: "label", class: "menu_item_name", text: "{item.name}" },
                          { widget: "spacer" },
                          { widget: "label", class: "menu_item_start", text: "{item.steps|int} steps" },
                        ],
                      },
                      { widget: "label", class: "dim", text: "{item.description}", visible: "item.description" },
                    ],
                  },
                ],
              },
            ],
          },
          {
            id: "controls",
            widget: "column",
            class: "menu_page menu_list",
            visible: "menu.page == controls",
            children: [
              {
                widget: "row",
                children: [
                  { widget: "label", class: "dim", style: { grow: 1 }, text: "Click a key, then press the one you want; Esc to leave it" },
                  { widget: "button", class: "menu_option", text: "Reset all", action: "keys.reset" },
                ],
              },
              {
                id: "keys",
                widget: "column",
                repeat: "keys.rows",
                style: { gap: 2 },
                children: [
                  {
                    widget: "row",
                    children: [
                      { widget: "label", class: "key", text: "{item.label}" },
                      { widget: "label", class: "warning", visible: "item.clash", text: "also {item.clash}" },
                      { widget: "button", class: "menu_option", active: "item.listening", text: "{item.key}", action: "keys.listen:{item.id}" },
                    ],
                  },
                ],
              },
            ],
          },
          {
            id: "interface",
            widget: "column",
            class: "menu_page menu_list",
            visible: "menu.page == interface",
            children: [
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Scale" },
                  { widget: "button", class: "menu_option", text: "75%", action: "interface.set:scale:75", active: "interface.scale == 75" },
                  { widget: "button", class: "menu_option", text: "90%", action: "interface.set:scale:90", active: "interface.scale == 90" },
                  { widget: "button", class: "menu_option", text: "100%", action: "interface.set:scale:100", active: "interface.scale == 100" },
                  { widget: "button", class: "menu_option", text: "110%", action: "interface.set:scale:110", active: "interface.scale == 110" },
                  { widget: "button", class: "menu_option", text: "125%", action: "interface.set:scale:125", active: "interface.scale == 125" },
                  { widget: "button", class: "menu_option", text: "150%", action: "interface.set:scale:150", active: "interface.scale == 150" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Alerts" },
                  { widget: "button", class: "menu_option", text: "Off", action: "interface.set:alerts:off", active: "interface.alerts == off" },
                  { widget: "button", class: "menu_option", text: "On", action: "interface.set:alerts:on", active: "interface.alerts == on" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Alert tone" },
                  { widget: "button", class: "menu_option", text: "Off", action: "interface.set:alert_tone:off", active: "interface.alert_tone == off" },
                  { widget: "button", class: "menu_option", text: "On", action: "interface.set:alert_tone:on", active: "interface.alert_tone == on" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Warp stops at signal changes" },
                  { widget: "button", class: "menu_option", text: "Off", action: "interface.set:warp_stops_at_signal:off", active: "interface.warp_stops_at_signal == off" },
                  { widget: "button", class: "menu_option", text: "On", action: "interface.set:warp_stops_at_signal:on", active: "interface.warp_stops_at_signal == on" },
                ],
              },
            ],
          },
          {
            id: "sound",
            widget: "column",
            class: "menu_page menu_list",
            visible: "menu.page == sound",
            children: [
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Volume" },
                  { widget: "button", class: "menu_option", text: "0%", action: "audio.set:master:0", active: "audio.master == 0" },
                  { widget: "button", class: "menu_option", text: "25%", action: "audio.set:master:25", active: "audio.master == 25" },
                  { widget: "button", class: "menu_option", text: "50%", action: "audio.set:master:50", active: "audio.master == 50" },
                  { widget: "button", class: "menu_option", text: "75%", action: "audio.set:master:75", active: "audio.master == 75" },
                  { widget: "button", class: "menu_option", text: "100%", action: "audio.set:master:100", active: "audio.master == 100" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Engines" },
                  { widget: "button", class: "menu_option", text: "0%", action: "audio.set:engines:0", active: "audio.engines == 0" },
                  { widget: "button", class: "menu_option", text: "25%", action: "audio.set:engines:25", active: "audio.engines == 25" },
                  { widget: "button", class: "menu_option", text: "50%", action: "audio.set:engines:50", active: "audio.engines == 50" },
                  { widget: "button", class: "menu_option", text: "75%", action: "audio.set:engines:75", active: "audio.engines == 75" },
                  { widget: "button", class: "menu_option", text: "100%", action: "audio.set:engines:100", active: "audio.engines == 100" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Wind" },
                  { widget: "button", class: "menu_option", text: "0%", action: "audio.set:wind:0", active: "audio.wind == 0" },
                  { widget: "button", class: "menu_option", text: "25%", action: "audio.set:wind:25", active: "audio.wind == 25" },
                  { widget: "button", class: "menu_option", text: "50%", action: "audio.set:wind:50", active: "audio.wind == 50" },
                  { widget: "button", class: "menu_option", text: "75%", action: "audio.set:wind:75", active: "audio.wind == 75" },
                  { widget: "button", class: "menu_option", text: "100%", action: "audio.set:wind:100", active: "audio.wind == 100" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Effects" },
                  { widget: "button", class: "menu_option", text: "0%", action: "audio.set:effects:0", active: "audio.effects == 0" },
                  { widget: "button", class: "menu_option", text: "25%", action: "audio.set:effects:25", active: "audio.effects == 25" },
                  { widget: "button", class: "menu_option", text: "50%", action: "audio.set:effects:50", active: "audio.effects == 50" },
                  { widget: "button", class: "menu_option", text: "75%", action: "audio.set:effects:75", active: "audio.effects == 75" },
                  { widget: "button", class: "menu_option", text: "100%", action: "audio.set:effects:100", active: "audio.effects == 100" },
                ],
              },
            ],
          },
          {
            id: "graphics",
            widget: "column",
            class: "menu_page menu_list",
            visible: "menu.page == graphics",
            children: [
              { widget: "label", class: "dim", text: "GPU: {perf.gpu}" },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Preset" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.preset:low", active: "graphics.preset == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.preset:medium", active: "graphics.preset == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.preset:high", active: "graphics.preset == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.preset:ultra", active: "graphics.preset == ultra" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "dim", style: { grow: 1 }, text: "Recommended for this GPU: {graphics.recommended|upper}" },
                  { widget: "label", class: "dim", visible: "graphics.preset == custom", text: "(custom)" },
                  { widget: "button", class: "menu_option", text: "Use recommended", action: "graphics.detect" },
                ],
              },
              { widget: "label", class: "section", text: "RENDERING" },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Render scale" },
                  { widget: "button", class: "menu_option", text: "50%", action: "graphics.set:render_scale:50", active: "graphics.render_scale == 50" },
                  { widget: "button", class: "menu_option", text: "67%", action: "graphics.set:render_scale:67", active: "graphics.render_scale == 67" },
                  { widget: "button", class: "menu_option", text: "75%", action: "graphics.set:render_scale:75", active: "graphics.render_scale == 75" },
                  { widget: "button", class: "menu_option", text: "85%", action: "graphics.set:render_scale:85", active: "graphics.render_scale == 85" },
                  { widget: "button", class: "menu_option", text: "100%", action: "graphics.set:render_scale:100", active: "graphics.render_scale == 100" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Anti-aliasing" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:antialiasing:off", active: "graphics.antialiasing == off" },
                  { widget: "button", class: "menu_option", text: "FXAA", action: "graphics.set:antialiasing:fxaa", active: "graphics.antialiasing == fxaa" },
                  { widget: "button", class: "menu_option", text: "MSAA 4x", action: "graphics.set:antialiasing:msaa", active: "graphics.antialiasing == msaa" },
                  { widget: "button", class: "menu_option", text: "TAA", action: "graphics.set:antialiasing:taa", active: "graphics.antialiasing == taa" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Shadows" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:shadows:off", active: "graphics.shadows == off" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:shadows:low", active: "graphics.shadows == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:shadows:medium", active: "graphics.shadows == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:shadows:high", active: "graphics.shadows == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:shadows:ultra", active: "graphics.shadows == ultra" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Ambient occlusion" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:ambient_occlusion:off", active: "graphics.ambient_occlusion == off" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:ambient_occlusion:low", active: "graphics.ambient_occlusion == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:ambient_occlusion:medium", active: "graphics.ambient_occlusion == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:ambient_occlusion:high", active: "graphics.ambient_occlusion == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:ambient_occlusion:ultra", active: "graphics.ambient_occlusion == ultra" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Bloom" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:bloom:off", active: "graphics.bloom == off" },
                  { widget: "button", class: "menu_option", text: "On", action: "graphics.set:bloom:on", active: "graphics.bloom == on" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Sky, haze and plumes" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:effects:low", active: "graphics.effects == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:effects:medium", active: "graphics.effects == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:effects:high", active: "graphics.effects == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:effects:ultra", active: "graphics.effects == ultra" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Clouds" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:clouds:off", active: "graphics.clouds == off" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:clouds:low", active: "graphics.clouds == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:clouds:medium", active: "graphics.clouds == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:clouds:high", active: "graphics.clouds == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:clouds:ultra", active: "graphics.clouds == ultra" },
                ],
              },
              { widget: "label", class: "section", text: "WORLD" },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Terrain detail" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:terrain:low", active: "graphics.terrain == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:terrain:medium", active: "graphics.terrain == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:terrain:high", active: "graphics.terrain == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:terrain:ultra", active: "graphics.terrain == ultra" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Trees" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:trees:off", active: "graphics.trees == off" },
                  { widget: "button", class: "menu_option", text: "Low", action: "graphics.set:trees:low", active: "graphics.trees == low" },
                  { widget: "button", class: "menu_option", text: "Medium", action: "graphics.set:trees:medium", active: "graphics.trees == medium" },
                  { widget: "button", class: "menu_option", text: "High", action: "graphics.set:trees:high", active: "graphics.trees == high" },
                  { widget: "button", class: "menu_option", text: "Ultra", action: "graphics.set:trees:ultra", active: "graphics.trees == ultra" },
                ],
              },
              { widget: "label", class: "section", text: "DISPLAY" },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "VSync" },
                  { widget: "button", class: "menu_option", text: "Off", action: "graphics.set:vsync:off", active: "graphics.vsync == off" },
                  { widget: "button", class: "menu_option", text: "On", action: "graphics.set:vsync:on", active: "graphics.vsync == on" },
                ],
              },
              {
                widget: "row",
                children: [
                  { widget: "label", class: "key", text: "Frame rate cap" },
                  { widget: "button", class: "menu_option", text: "None", action: "graphics.set:fps_limit:0", active: "graphics.fps_limit == 0" },
                  { widget: "button", class: "menu_option", text: "30", action: "graphics.set:fps_limit:30", active: "graphics.fps_limit == 30" },
                  { widget: "button", class: "menu_option", text: "60", action: "graphics.set:fps_limit:60", active: "graphics.fps_limit == 60" },
                  { widget: "button", class: "menu_option", text: "120", action: "graphics.set:fps_limit:120", active: "graphics.fps_limit == 120" },
                ],
              },
              {
                widget: "row",
                style: { margin: [8, 0, 0, 0] },
                children: [
                  { widget: "label", class: "title", text: "{perf.fps|int} fps" },
                  { widget: "label", class: "dim", style: { grow: 1 }, text: "{perf.frame_ms|fixed:1} ms, limited by {perf.bound}" },
                  { widget: "button", class: "menu_option", text: "Details (F10)", action: "ui.toggle:perf", active: "ui.shown.perf" },
                ],
              },
              { widget: "label", class: "dim", text: "Render scale and anti-aliasing matter most when the GPU limits the frame rate. Changes apply at once and are saved." },
            ],
          },
          { widget: "label", class: "dim", text: "{menu.notice}", visible: "menu.notice" },
          {
            widget: "row",
            children: [
              { widget: "button", text: "Resume", action: "game.resume", visible: "menu.playing" },
              { widget: "button", text: "Save", action: "game.save", visible: "menu.playing", tooltip: "Save this game" },
              { widget: "button", text: "Save as new", action: "game.save_as", visible: "menu.playing", tooltip: "Keep the last save, and save this game as another" },
              { widget: "spacer" },
              { widget: "button", text: "Quit", action: "game.quit" },
            ],
          },
        ],
      },
    ],
  },
}
