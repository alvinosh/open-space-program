// The sequence stack (bottom of the left dock): each numbered row is a sequence
// the stage key fires, the next one at the bottom and outlined. A row is a box of its own,
// no wider than its parts: small tiles, four to a line, one per group of identical parts,
// with how many and, for engines and RCS, the fuel feeding them as a thin bar in the
// stage's colour (as in the Resources window). Engines are liquid, vacuum or solid; the
// rest are decouplers, fairing panels and RCS. Hover a tile for what it does with its
// thrust, Isp, burn time and fuel; hover a row's number for the whole row. The box at the very
// bottom has two tabs: the delta-v and thrust-to-weight of the stage burning, and the pitch, yaw
// and roll being commanded, whether by the pilot or by SAS.
//
// Reorder by dragging: a row anywhere on it, onto another row to put it there, or onto
// the thin strip under a row (it lights up) to put it at exactly that place. A tile
// dragged onto a row joins it at the end, onto a tile it goes just before that tile (a row does
// its tiles left to right), onto a strip it makes a sequence of its own there; drag its
// count to move just one. The arrows on a row move it up and down the stack too. To choose which
// of a tile's parts goes first (a cluster's centre engine, say), use Split off in the part's own
// window. Right-click a tile for the window of its first part: the tile takes the window's
// colour and every part of the tile is tinted in it on the rocket (see part_info.json5).
// Right-click anywhere else on a row for its menu (staging_menu.json5). Under the pointer, a
// tile (or a row's number) tints its parts blue on the rocket; the engines of the next row are
// teal. The + box at the top adds an empty sequence (and takes a dropped tile as a new last one),
// x removes an empty one, and the arrow beside the + undoes the last change.
// Under the stack, numbered after the last sequence fired, are the engines already lit,
// their fuel draining, until their stage falls away. F8 shows and hides it.
{
  id: "staging",
  group: "flight",
  dock: "left_bottom",
  root: {
    id: "staging",
    widget: "column",
    class: "seq_stack",
    children: [
      // Adds a sequence; also the strip above the last row for a dropped tile.
      {
        widget: "row",
        class: "seq_row seq_add",
        drop: "staging.drop_new:$drag",
        children: [
          { widget: "button", class: "seq_glyph", text: "+", tooltip: "New sequence", action: "staging.add" },
          { widget: "button", class: "seq_glyph", tooltip: "Undo the last change", visible: "vessel.can_undo_sequences", action: "staging.undo", children: [{ widget: "image", class: "seq_glyph_icon", image: "icons/undo.svg" }] },
        ],
      },
      {
        id: "sequences",
        widget: "column",
        class: "seq_stack",
        repeat: "vessel.sequences",
        style: { direction: "column_reverse" },
        children: [
          {
            widget: "column",
            class: "seq_stack",
            children: [
              // The strip under a row is the place before it.
              { widget: "column", class: "seq_gap", drop: "staging.drop_at:$drag:{item.index}" },
              {
                widget: "row",
                class: "seq_row",
                active: "item.next",
                drag: "seq:{item.index}",
                drop: "staging.drop:$drag:{item.index}",
                context: "staging.menu:{item.index}",
                children: [
                  { widget: "label", class: "seq_number", active: "item.next", tooltip: "{item.caption}", hover: "part.group:{item.window}", text: "{item.number}" },
                  {
                    widget: "column",
                    class: "seq_tiles",
                    repeat: "item.lines",
                    children: [
                      {
                        widget: "row",
                        class: "seq_line",
                        repeat: "item.tiles",
                        children: [
                          {
                            widget: "column",
                            class: "seq_item",
                            drag: "item:{item.seq}:{item.index}",
                            drop: "staging.drop_before:$drag:{item.seq}:{item.index}",
                            tooltip: "{item.tip}",
                            context: "part.group:{item.window}",
                            hover: "part.group:{item.window}",
                            accent: "item.mark",
                            children: [
                              { widget: "image", class: "seq_icon", image: "icons/engine.svg", visible: "item.is_engines" },
                              { widget: "image", class: "seq_icon", image: "icons/vacuum_engine.svg", visible: "item.is_vacuum" },
                              { widget: "image", class: "seq_icon", image: "icons/solid_motor.svg", visible: "item.is_solid" },
                              { widget: "image", class: "seq_icon", image: "icons/decoupler.svg", visible: "item.is_decoupler" },
                              { widget: "image", class: "seq_icon", image: "icons/fairing.svg", visible: "item.is_fairing" },
                              { widget: "image", class: "seq_icon", image: "icons/rcs.svg", visible: "item.is_rcs" },
                              { widget: "image", class: "seq_icon", image: "icons/cutoff.svg", visible: "item.is_cutoff" },
                              { widget: "image", class: "seq_icon", image: "icons/throttle.svg", visible: "item.is_throttle" },
                              { widget: "image", class: "seq_icon", image: "icons/part.svg", visible: "item.is_other" },
                              { widget: "label", class: "seq_count", drag: "one:{item.seq}:{item.index}", text: "{item.count}", visible: "item.multiple" },
                              { widget: "bar", class: "seq_fuel", value: "item.fuel", color: "item.color", visible: "item.has_fuel" },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                  { widget: "button", class: "seq_glyph", text: "×", tooltip: "Remove", visible: "item.empty", action: "staging.remove:{item.index}" },
                  {
                    widget: "column",
                    class: "seq_arrows",
                    children: [
                      { widget: "button", class: "seq_arrow", tooltip: "Fire it later", visible: "item.can_up", action: "staging.drop:seq:{item.index}:{item.above}", children: [{ widget: "image", class: "seq_arrow_icon", image: "icons/sequence_up.svg" }] },
                      { widget: "button", class: "seq_arrow", tooltip: "Fire it sooner", visible: "item.can_down", action: "staging.drop:seq:{item.index}:{item.below}", children: [{ widget: "image", class: "seq_arrow_icon", image: "icons/sequence_down.svg" }] },
                    ],
                  },
                ],
              },
            ],
          },
        ],
      },
      {
        id: "armed",
        widget: "row",
        class: "seq_row seq_armed",
        visible: "vessel.armed_count",
        style: { margin: [3, 0, 0, 0] },
        children: [
          { widget: "label", class: "seq_number", text: "{vessel.armed_number}" },
          {
            widget: "column",
            class: "seq_tiles",
            repeat: "vessel.armed_lines",
            children: [
              {
                widget: "row",
                class: "seq_line",
                repeat: "item.tiles",
                children: [
                  {
                    widget: "column",
                    class: "seq_item",
                    tooltip: "{item.tip}",
                    context: "part.group:{item.window}",
                    hover: "part.group:{item.window}",
                    accent: "item.mark",
                    children: [
                      { widget: "image", class: "seq_icon", image: "icons/engine.svg", visible: "item.is_engines" },
                      { widget: "image", class: "seq_icon", image: "icons/vacuum_engine.svg", visible: "item.is_vacuum" },
                      { widget: "image", class: "seq_icon", image: "icons/solid_motor.svg", visible: "item.is_solid" },
                      { widget: "label", class: "seq_count", text: "{item.count}", visible: "item.multiple" },
                      { widget: "bar", class: "seq_fuel", value: "item.fuel", color: "item.color", visible: "item.has_fuel" },
                    ],
                  },
                ],
              },
            ],
          },
        ],
      },
      // What the stage burning gives, or what the controls are doing.
      {
        id: "stage_tabs",
        widget: "column",
        class: "seq_row seq_stats",
        children: [
          {
            widget: "row",
            class: "seq_tabs",
            children: [
              { widget: "button", class: "seq_tab", text: "dV / TWR", tooltip: "Delta-v and thrust-to-weight of the stage burning", action: "ui.tab:staging:stage", active: "ui.tab.staging != inputs" },
              { widget: "button", class: "seq_tab", text: "P / Y / R", tooltip: "Pitch, yaw and roll input", action: "ui.tab:staging:inputs", active: "ui.tab.staging == inputs" },
            ],
          },
          {
            id: "stage_stats",
            widget: "column",
            class: "seq_page",
            visible: "ui.tab.staging != inputs",
            children: [
              {
                widget: "row",
                style: { gap: 4 },
                children: [
                  { widget: "label", class: "seq_key", style: { min_width: 24 }, text: "dV" },
                  { widget: "label", class: "seq_stat", text: "{vessel.delta_v|speed}" },
                ],
              },
              {
                widget: "row",
                style: { gap: 4 },
                children: [
                  { widget: "label", class: "seq_key", style: { min_width: 24 }, text: "TWR" },
                  { widget: "label", class: "seq_stat", text: "{vessel.stage_twr|fixed:2}" },
                ],
              },
            ],
          },
          {
            id: "inputs",
            widget: "column",
            class: "seq_page",
            visible: "ui.tab.staging == inputs",
            children: [
              { widget: "row", class: "seq_input", tooltip: "Pitch input", children: [{ widget: "label", class: "seq_key", style: { min_width: 8 }, text: "P" }, { widget: "bar", class: "ibar", value: "control.pitch", min: -1 }] },
              { widget: "row", class: "seq_input", tooltip: "Yaw input", children: [{ widget: "label", class: "seq_key", style: { min_width: 8 }, text: "Y" }, { widget: "bar", class: "ibar", value: "control.yaw", min: -1 }] },
              { widget: "row", class: "seq_input", tooltip: "Roll input", children: [{ widget: "label", class: "seq_key", style: { min_width: 8 }, text: "R" }, { widget: "bar", class: "ibar", value: "control.roll", min: -1 }] },
            ],
          },
        ],
      },
    ],
  },
}
