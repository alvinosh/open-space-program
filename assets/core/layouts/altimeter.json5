// Altitude above sea level (top centre), and the situation; hover for the vessel's name.
{
  id: "altimeter",
  group: "flight",
  root: {
    id: "altimeter",
    widget: "panel",
    class: "module",
    style: { left: "50%", margin: [0, 0, 0, -80], top: 12, width: 160, align_items: "center", gap: 0, padding: [3, 8, 4, 8] },
    tooltip: "{vessel.name}",
    children: [
      { widget: "label", class: "alt_readout", text: "{vessel.altitude|distance}" },
      { widget: "label", class: "caption", text: "{vessel.situation}, {vessel.body}" },
    ],
  },
}
