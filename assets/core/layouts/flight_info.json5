// Flight data window. Node ids (#flight) are stable for mods to insert rows.
{
  id: "flight_info",
  group: "flight",
  dock: "left",
  dock_order: 10,
  root: {
    widget: "window",
    title: "Flight",
    style: { width: 300 },
    children: [
      {
        id: "flight",
        widget: "column",
        children: [
          { widget: "row", children: [{ widget: "label", class: "key", text: "Vertical speed" }, { widget: "label", text: "{vessel.vertical_speed|speed}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Surface speed" }, { widget: "label", text: "{vessel.surface_speed|speed}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Orbital speed" }, { widget: "label", text: "{vessel.orbital_speed|speed}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Mach" }, { widget: "label", text: "{vessel.mach|fixed:2}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Dynamic Q" }, { widget: "label", text: "{vessel.dynamic_pressure|pressure}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Angle of attack" }, { widget: "label", text: "{vessel.angle_of_attack|degrees:1}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Sideslip" }, { widget: "label", text: "{vessel.sideslip|degrees:1}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Drag" }, { widget: "label", text: "{vessel.drag|force}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Lift" }, { widget: "label", text: "{vessel.lift|force}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Air pressure" }, { widget: "label", text: "{vessel.static_pressure|pressure}" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Acceleration" }, { widget: "label", text: "{vessel.accel_g|fixed:2} g" }] },
          { widget: "row", children: [{ widget: "label", class: "key", text: "Motion" }, { widget: "label", text: "{vessel.motion}" }] },
        ],
      },
    ],
  },
}
