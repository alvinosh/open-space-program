// Controls reference (F1).
{
  id: "help",
  visible: false,
  root: {
    widget: "window",
    title: "Controls",
    style: { left: "40%", top: 120, width: 400 },
    children: [
      { widget: "row", children: [{ widget: "label", class: "key", text: "Shift / Ctrl" }, { widget: "label", text: "throttle up / down" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "Z / X" }, { widget: "label", text: "full / cut throttle" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "W S / A D / Q E" }, { widget: "label", text: "pitch / yaw / roll" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "T" }, { widget: "label", text: "SAS on / off (modes next to the navball)" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "R" }, { widget: "label", text: "RCS on / off" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "H N / J L / I K" }, { widget: "label", text: "RCS forward, back / left, right / up, down" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "Space" }, { widget: "label", text: "stage" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: ", . /" }, { widget: "label", text: "warp down / up / stop" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "M" }, { widget: "label", text: "map view" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "Right drag, wheel" }, { widget: "label", text: "orbit / zoom camera" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "F1" }, { widget: "label", text: "this help" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "F2" }, { widget: "label", text: "mods & diagnostics" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "F3" }, { widget: "label", text: "hide / show the flight UI" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "F5" }, { widget: "label", text: "reload mods & UI" }] },
      { widget: "row", children: [{ widget: "label", class: "key", text: "F12" }, { widget: "label", text: "data inspector (for modders)" }] },
      { widget: "label", class: "dim", style: { margin: [8, 0, 0, 0] }, text: "The buttons at the top right open and close the flight windows. Click the speed above the navball to switch between surface and orbit speed." },
      { widget: "label", class: "dim", style: { margin: [4, 0, 0, 0] }, text: "Engines that need ullage only light while the propellant is settled. After a coast, turn RCS on and hold H while throttling up." },
    ],
  },
}
