// The goals of the mission a scenario sets (`goals` in its record; see Missions in
// docs/modding.md). It opens when such a scenario starts, ticks a goal off when it is met,
// and can be closed. Node ids (#goals) are stable for mods to insert rows.
{
  id: "mission_goals",
  visible: false,
  group: "flight",
  dock: "left",
  dock_order: 5,
  root: {
    widget: "window",
    icon: "icons/target.svg",
    title: "Mission",
    style: { width: 250 },
    children: [
      {
        id: "goals",
        widget: "column",
        repeat: "mission.goals",
        children: [
          {
            widget: "row",
            class: "kv",
            children: [
              { widget: "image", class: "goal_mark", image: "icons/goal_done.svg", visible: "item.met", active: "item.met" },
              { widget: "image", class: "goal_mark", image: "icons/goal.svg", visible: "!item.met", active: "item.current" },
              { widget: "label", class: "goal_text", text: "{item.text}", active: "item.met" },
              { widget: "label", class: "dim", text: "{item.held|percent}", visible: "item.held" },
            ],
          },
        ],
      },
      { widget: "label", class: "dim", text: "{mission.met} of {mission.count} done" },
    ],
  },
}
