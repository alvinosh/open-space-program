// Screen messages under the altimeter: the latest event (ignition, staging, SOI change),
// warp notices and mission news, for a few seconds each.
{
  id: "messages",
  group: "flight",
  root: {
    id: "messages",
    widget: "column",
    class: "module",
    style: { left: "50%", margin: [0, 0, 0, -300], top: 110, width: 600, align_items: "center", gap: 4 },
    children: [
      // What wants attention right now (see `alerts`).
      {
        id: "alerts",
        widget: "row",
        visible: "alerts.any",
        repeat: "alerts.list",
        style: { gap: 6 },
        children: [{ widget: "label", class: "alert_chip", text: "{item.text}" }],
      },
      { widget: "label", class: "warning notice", style: { font_size: 16 }, text: "{screen.message}", visible: "screen.message" },
      { widget: "label", class: "warning notice", text: "{time.notice}", visible: "time.notice" },
      // A quicksave made or loaded (F5, F9), or why it was not.
      { widget: "label", class: "notice", style: { font_size: 16 }, text: "{saves.flash}", visible: "saves.flash" },
      // A goal met or the mission passed, and the mission failed.
      { widget: "label", class: "notice goal_notice", style: { font_size: 16 }, text: "{mission.notice}", visible: "mission.notice" },
      { widget: "label", class: "warning notice", style: { font_size: 16 }, text: "{mission.notice_bad}", visible: "mission.notice_bad" },
      { widget: "label", class: "warning notice", text: "Simulation is lagging behind the requested warp", visible: "time.lagging" },
      // Map view: what a click on the trajectory does (the ghost node there says when).
      { widget: "label", class: "dim notice", text: "Click to add a manoeuvre, right-click for more", visible: "map.hovering" },
    ],
  },
}
