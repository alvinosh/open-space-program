// Launch sites. A site's pad and roads become part of the body's terrain (for collision as
// well as rendering), and its structures are drawn around the pad. Scenarios start on a
// site with `start: { type: "LaunchSite", site: "<id>" }`.
//
// Layout coordinates are metres in the site frame: [right, forward], where forward points
// along `heading` (degrees clockwise from north).
[
  {
    id: "cape_canaveral",
    name: "Cape Canaveral LC-39A",
    body: "Earth",
    latitude: 28.6083,
    longitude: -80.6041,
    heading: 0,
    pad: {
      // A small concrete deck raised on an embankment above the coastal scrub.
      size: [90, 70],
      corner_radius: 12,
      elevation: 7,
      slope: 0.4,
      // The vehicle stands on its hold-downs with the engine bells above the trench grate.
      mount_height: 3,
    },
    roads: [
      // Out west-southwest across the marsh, roughly along the old crawlerway.
      { points: [[-40, -6], [-260, -110], [-700, -360], [-1500, -800]], width: 9 },
    ],
  },
]
