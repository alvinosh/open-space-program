// What engines and tanks hold in the base game. `density` is as stored (kg/m³). Tanks can only hold
// a resource if they are insulated down to its storage `temperature` (K, default 293) and rated for
// its storage `pressure` (Pa, for compressed gases). The real propellants are in the Realistic
// Fuels mod (mods/realistic_fuels).
[
  { id: "Liquid Fuel", density: 820 },
  { id: "Oxidiser", density: 1141 },
  { id: "Solid Fuel", density: 1770 },
  { id: "Supplies", density: 600 }, // what people live on in the casual game: food, water and air in one
]
