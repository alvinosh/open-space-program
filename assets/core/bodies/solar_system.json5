  {
    id: "Venus",
    albedo: 0.76,
    parent: "Sun",
    gm: 3.24859e+14,
    radius: 6051800.0,
    rotation: {
      pole_ra: 272.76,
      pole_dec: 67.16,
      prime_meridian: 160.2,
      rate: -1.4813688,
    },
    atmosphere: {
      model: {
        type: "Exponential",
        surface_pressure: 9200000.0,
        scale_height: 15900.0,
        temperature: 737.0,
        molar_mass: 0.04345,
      },
      height: 250000.0,
    },
    // Effective numbers, not the real optical depth of about 100: the clouds scatter so far
    // forward that some 2% of the sunlight still reaches the ground, which a single-scattering
    // march only gets from a depth of about 4. The result is a creamy disc from space and a
    // dim orange sky at the surface, as the Venera probes saw.
    scattering: {
      height: 200000,
      rayleigh: [1e-6, 2e-6, 5e-6],
      rayleigh_height: 15900,
      mie: [2.5e-4, 2.3e-4, 1.7e-4],
      mie_absorption: [1e-6, 8e-6, 3e-5],
      mie_height: 15900,
      mie_g: [0.75, 0.75, 0.75],
      ground_albedo: [0.2, 0.15, 0.1],
    },
    // The unbroken sulphuric deck; the bands only leave it its faint large-scale structure.
    clouds: {
      base: 48000,
      top: 70000,
      albedo: [0.995, 0.97, 0.9],
      bands: [[0, 1.0], [90, 1.0]],
      storms: 6,
      storm_latitude: [50, 80],
      wind: 80,
      seed: 7,
    },
    orbit: {
      semi_major_axis: 108208000000,
      eccentricity: 0.006772,
      inclination: 3.39458,
      longitude_of_ascending_node: 76.68,
      argument_of_periapsis: 54.884,
      mean_anomaly_at_epoch: 50.115,
    },
    color: [0.85, 0.75, 0.55],
  },
  {
    id: "Earth",
    albedo: 0.306,
    parent: "Sun",
    gm: 3.986004418e+14,
    radius: 6371000.0,
    // Elevation, colour, land cover and night lights baked from public datasets by
    // `cargo run -p osp_bake --release` (see assets/core/terrain/README.md).
    terrain: "terrain/earth",
    max_terrain_height: 8900,
    rotation: {
      pole_ra: 0.0,
      pole_dec: 90.0,
      prime_meridian: 190.147,
      rate: 360.9856235,
    },
    atmosphere: {
      model: {
        type: "Us1976",
      },
      height: 140000.0,
    },
    // Hillaire's (2020) clear-air fit: Rayleigh from Bucholtz, aerosols near sea level, and the
    // ozone that keeps the twilight sky blue.
    scattering: {
      height: 100000,
      rayleigh: [5.802e-6, 13.558e-6, 33.1e-6],
      rayleigh_height: 8000,
      mie: [3.996e-6, 3.996e-6, 3.996e-6],
      mie_absorption: [4.44e-7, 4.44e-7, 4.44e-7],
      mie_height: 1200,
      mie_g: [0.8, 0.8, 0.8],
      ozone: [6.5e-7, 1.881e-6, 8.5e-8],
      ozone_height: 25000,
      ozone_width: 15000,
      // Vegetation, soil and sand; the sea is darker, snow and cloud brighter.
      ground_albedo: [0.11, 0.12, 0.08],
    },
    // Cover by latitude after satellite records: the rain belt, the clear subtropics, the storm
    // tracks. Most clouds stay low; only deep storms reach the top of the layer. It has a map of its
    // own, so the weather is only for the thin high cloud.
    clouds: {
      base: 1000,
      top: 12000,
      map: "clouds/fair",
      albedo: [0.995, 0.995, 0.995],
      bands: [[0, 0.6], [8, 0.68], [25, 0.34], [45, 0.6], [60, 0.78], [75, 0.62], [90, 0.5]],
      storms: 18,
      storm_latitude: [35, 65],
      hurricanes: 3,
      wind: 12,
      cirrus_height: 9500,
      cirrus: 0.5,
      // Turns the map to give broken cloud over the Cape, and some high cloud.
      seed: 180,
    },
    // A fresh breeze blown over open water, for the waves' spectrum.
    ocean: {
      wind_speed: 8,
      wind_direction: 40,
      fetch: 300000,
      gravity: 9.81,
    },
    orbit: {
