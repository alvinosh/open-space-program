// Crew pods. A pod sits at the top of its stage (`pod: "<id>"`); its mass (with crew and
// consumables, kg) counts as structure. `diameter` is the base, `height` the whole pod (m),
// `top_diameter` the top (the air sees the pod as a frustum). `supplies`: days of what its crew
// need, in its lockers, under whatever life support the game has. `drive`: room for what
// experiments make, `{ data: <bytes>, samples: <kg> }`; 2 MB and 5 kg a seat if not given.
// `electric_charge`: kJ in its batteries (Mercury flew on about 13.5 kWh, 48,600 kJ).
// Models are glTF, origin at the centre of the base, nose up.
[
  {
    id: "C-1 Capsule", // one person, Mercury/Vostok era
    mass: 1350,
    crew: 1,
    diameter: 1.9,
    height: 2.9,
    top_diameter: 0.73,
    model: "models/pods/c1.glb",
    supplies: 14, // days
    electric_charge: 36000, // 10 kWh
  },
  {
    id: "C-4 Capsule", // four people, Dragon/Orion class
    mass: 9500,
    crew: 4,
    diameter: 3.7,
    height: 3.9,
    top_diameter: 1.1,
    model: "models/pods/c4.glb",
    supplies: 30, // days
    electric_charge: 72000, // 20 kWh
  },
]
