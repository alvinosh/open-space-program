// The casual game's tech tree (the `casual` record of tech_trees). Each node costs `cost` science
// and needs every one of its `parents` first; it unlocks the parts-list entries in `parts`.
// `sizes.diameter` is the widest a tank (or any procedural part) can be built once it is unlocked:
// 2 m from the start, then 3, 4, 6 and 10 m up the rocketry line.
// `position` is [tier, row]: tiers run left to right, each costing more than the one before.
[
  // Tier 0: what a science game starts with. A capsule, a tank, a small engine to cluster, and
  // what holds a rocket together.
  {
    id: "first_steps",
    title: "First Steps",
    description: "A one-seat capsule, tanks, a small engine to cluster under them, and the parts that hold a rocket together.",
    cost: 0,
    position: [0, 2],
    parts: ["pod:C-1 Capsule", "tank", "nose_cone", "decoupler", "fin", "engine:K-0", "engine:S-1", "instrument:thermometer", "instrument:barometer"],
    sizes: { diameter: 2 },
  },
  // Tier 1.
  {
    id: "basic_rocketry",
    title: "Basic Rocketry",
    description: "An upper stage engine that lights in space, and tubes to space the stages.",
    cost: 5,
    parents: ["first_steps"],
    position: [1, 1],
    parts: ["engine:A-10", "structural", "instrument:camera"],
  },
  {
    id: "aerodynamics",
    title: "Aerodynamics",
    description: "Wings, for lift and to steer in the air.",
    cost: 5,
    parents: ["first_steps"],
    position: [1, 4],
    parts: ["wing"],
  },
  // Tier 2.
  {
    id: "general_rocketry",
    title: "General Rocketry",
    description: "A booster engine big enough to lift a capsule on its own, and fuel lines to feed boosters from their neighbours.",
    cost: 18,
    parents: ["basic_rocketry"],
    position: [2, 0],
    parts: ["engine:K-1 Booster", "fuel_line"],
    sizes: { diameter: 3 },
  },
  {
    id: "flight_control",
    title: "Flight Control",
    description: "A reaction wheel and cold gas thrusters to turn and move in space.",
    cost: 18,
    parents: ["basic_rocketry"],
    position: [2, 2],
    parts: ["wheel:RW-1", "rcs:Cold Gas Quad"],
  },
  {
    id: "electrics",
    title: "Electrics",
    description: "Batteries and solar panels: power for longer flights.",
    cost: 18,
    parents: ["first_steps"],
    position: [2, 3],
    parts: ["battery", "solar_panel", "instrument:magnetometer"],
  },
  {
    id: "aviation",
    title: "Aviation",
    description: "A throttleable rocket-plane engine and landing gear.",
    cost: 18,
    parents: ["aerodynamics"],
    position: [2, 4],
    parts: ["engine:R-6", "wheel", "nose_wheel"],
  },
  // Tier 3.
  {
    id: "advanced_rocketry",
    title: "Advanced Rocketry",
    description: "A vacuum engine for upper stages and a heavy hypergolic booster.",
    cost: 45,
    parents: ["general_rocketry"],
    position: [3, 0],
    parts: ["engine:K-1 Vacuum", "engine:A-87"],
    sizes: { diameter: 4 },
  },
  {
    id: "uncrewed_craft",
    title: "Uncrewed Craft",
    description: "A probe core to fly without a crew, and a big reaction wheel.",
    cost: 45,
    parents: ["flight_control", "electrics"],
    position: [3, 2],
    parts: ["probe_core", "wheel:Attitude Control Unit", "instrument:surface_sampler"],
  },
  {
    id: "communication",
    title: "Communication",
    description: "Antennas to talk to the ground from orbit and the Moon.",
    cost: 45,
    parents: ["electrics"],
    position: [3, 3],
    parts: ["antenna", "small_dish"],
  },
  // Tier 4.
  {
    id: "crewed_exploration",
    title: "Crewed Exploration",
    description: "A four-seat capsule and supplies for long trips.",
    cost: 90,
    parents: ["advanced_rocketry"],
    position: [4, -1],
    parts: ["pod:C-4 Capsule", "supplies"],
  },
  {
    id: "heavy_rocketry",
    title: "Heavy Rocketry",
    description: "Big engines for big rockets: a staged-combustion booster and a hydrogen upper stage.",
    cost: 90,
    parents: ["advanced_rocketry"],
    position: [4, 0],
    parts: ["engine:K-19", "engine:H-2"],
    sizes: { diameter: 6 },
  },
  {
    id: "high_energy_propulsion",
    title: "High-Energy Propulsion",
    description: "A small hydrogen engine with the best efficiency in the tree.",
    cost: 90,
    parents: ["advanced_rocketry"],
    position: [4, 1],
    parts: ["engine:H-10"],
  },
  {
    id: "advanced_control",
    title: "Advanced Control",
    description: "Hypergolic thrusters, ten times the push of cold gas, for docking big craft.",
    cost: 90,
    parents: ["uncrewed_craft"],
    position: [4, 2],
    parts: ["rcs:Hypergolic Quad"],
  },
  {
    id: "long_range_communication",
    title: "Long-Range Communication",
    description: "Dishes to reach the planets, and a relay to pass on others' signals.",
    cost: 90,
    parents: ["communication"],
    position: [4, 3],
    parts: ["dish", "relay_dish"],
  },
  // Tier 5.
  {
    id: "very_heavy_rocketry",
    title: "Very Heavy Rocketry",
    description: "The biggest single engines: a Moon-rocket booster and a reusable hydrogen main engine.",
    cost: 180,
    parents: ["heavy_rocketry"],
    position: [5, 0],
    parts: ["engine:K-5", "engine:H-25"],
    sizes: { diameter: 10 },
  },
  {
    id: "nuclear_power",
    title: "Nuclear Power",
    description: "A radioisotope generator: power where the Sun is too weak.",
    cost: 180,
    parents: ["long_range_communication"],
    position: [5, 2],
    parts: ["rtg"],
  },
  {
    id: "deep_space_communication",
    title: "Deep Space Communication",
    description: "The largest dishes and relays, for the outer planets.",
    cost: 180,
    parents: ["long_range_communication"],
    position: [5, 3],
    parts: ["large_dish", "deep_relay"],
  },
  // Tier 6.
  {
    id: "next_generation_engines",
    title: "Next-Generation Engines",
    description: "Full-flow methane engines, for the booster and in vacuum.",
    cost: 400,
    parents: ["very_heavy_rocketry", "high_energy_propulsion"],
    position: [6, 0],
    parts: ["engine:M-2", "engine:M-2 Vacuum"],
  },
]
