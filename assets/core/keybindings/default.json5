// Key -> action bindings. `hold: true` actions are active while the key is down.
// Key names are Bevy KeyCodes: "KeyA".."KeyZ", "Digit0".., "F1".., "Space", "ShiftLeft",
// "ControlLeft", "Comma", "Period", "Slash", "ArrowUp", ...
// Mods can add another keybindings record or patch this one (e.g. op "set" on
// path "bindings[action=vessel.stage].key"). One with a `label` can be rebound by the player on
// the menu's Controls page; what they choose is kept in their settings, over what is here.
{
  id: "default",
  bindings: [
    { key: "Space", action: "vessel.stage", label: "Next sequence" },
    { key: "Backspace", action: "vessel.abort", label: "Abort" },
    { key: "F8", action: "ui.toggle:staging", label: "Staging window" },
    { key: "ShiftLeft", action: "vessel.throttle_up", hold: true, label: "Throttle up" },
    { key: "ControlLeft", action: "vessel.throttle_down", hold: true, label: "Throttle down" },
    { key: "KeyZ", action: "vessel.throttle_full", label: "Full throttle" },
    { key: "KeyX", action: "vessel.throttle_cut", label: "Cut throttle" },
    { key: "KeyW", action: "vessel.pitch_down", hold: true, label: "Pitch down" },
    { key: "KeyS", action: "vessel.pitch_up", hold: true, label: "Pitch up" },
    { key: "KeyA", action: "vessel.yaw_left", hold: true, label: "Yaw left" },
    { key: "KeyD", action: "vessel.yaw_right", hold: true, label: "Yaw right" },
    { key: "KeyQ", action: "vessel.roll_left", hold: true, label: "Roll left" },
    { key: "KeyE", action: "vessel.roll_right", hold: true, label: "Roll right" },
    { key: "KeyT", action: "vessel.sas_toggle", label: "SAS" },
    { key: "KeyB", action: "vessel.brakes", hold: true, label: "Brakes" },
    { key: "Escape", action: "game.menu", label: "Menu" },
    { key: "KeyR", action: "vessel.rcs_toggle", label: "RCS" },
    { key: "KeyH", action: "vessel.translate_forward", hold: true, label: "Translate forward" },
    { key: "KeyN", action: "vessel.translate_back", hold: true, label: "Translate back" },
    { key: "KeyJ", action: "vessel.translate_left", hold: true, label: "Translate left" },
    { key: "KeyL", action: "vessel.translate_right", hold: true, label: "Translate right" },
    { key: "KeyI", action: "vessel.translate_up", hold: true, label: "Translate up" },
    { key: "KeyK", action: "vessel.translate_down", hold: true, label: "Translate down" },
    { key: "Period", action: "warp.increase", label: "Faster warp" },
    { key: "Comma", action: "warp.decrease", label: "Slower warp" },
    { key: "Slash", action: "warp.stop", label: "Stop warp" },
    { key: "KeyM", action: "view.toggle_map", label: "Map" },
    { key: "BracketRight", action: "vessel.next", label: "Next vessel" },
    { key: "BracketLeft", action: "vessel.previous", label: "Previous vessel" },
    { key: "F1", action: "ui.toggle:help", label: "Help" },
    { key: "F2", action: "ui.toggle:mods", label: "Mods" },
    { key: "F3", action: "ui.toggle_group:flight", label: "Hide the HUD" },
    { key: "F5", action: "game.quicksave", label: "Quicksave" },
    { key: "F9", action: "game.quickload", hold: true, label: "Quickload (hold)" },
    { key: "F7", action: "game.reload" },
    { key: "KeyG", action: "debug.mark" },
    { key: "F10", action: "ui.toggle:perf" },
    { key: "F4", action: "ui.toggle:transfer_planner", label: "Transfer planner" },
    { key: "F6", action: "ui.toggle:alarm_clock", label: "Alarm clock" },
    { key: "F11", action: "ui.toggle:manifest", label: "Universe manifest" },
    { key: "KeyC", action: "camera.port_view", label: "Look out of the docking port" },
    { key: "KeyO", action: "debug.colliders", label: "Show what vessels collide with" },
    { key: "F12", action: "ui.toggle:data_inspector" },
  ],
}
